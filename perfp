DDL = """
PRAGMA journal_mode=OFF;
PRAGMA synchronous=OFF;

CREATE TABLE meta(key TEXT PRIMARY KEY, value TEXT);

CREATE TABLE cores(
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    sort_index INTEGER,
    n_events INTEGER DEFAULT 0,
    n_x INTEGER DEFAULT 0,
    dur_sum_us REAL DEFAULT 0,
    ts_min REAL,
    ts_max REAL
);

CREATE TABLE pipes(
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    n_events INTEGER DEFAULT 0,
    dur_sum_us REAL DEFAULT 0
);

CREATE TABLE names(
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE,
    n_events INTEGER DEFAULT 0,
    n_x INTEGER DEFAULT 0,
    dur_sum_us REAL DEFAULT 0
);

CREATE TABLE code_stacks(
    id INTEGER PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,
    inner_file TEXT,
    inner_line INTEGER,
    outer_file TEXT,
    outer_line INTEGER,
    n_events INTEGER DEFAULT 0,
    dur_sum_us REAL DEFAULT 0
);

CREATE TABLE locations(
    id INTEGER PRIMARY KEY,
    text TEXT NOT NULL UNIQUE,
    file TEXT,
    line INTEGER
);

CREATE TABLE details(
    id INTEGER PRIMARY KEY,
    detail TEXT NOT NULL UNIQUE
);

CREATE TABLE pcs(
    id INTEGER PRIMARY KEY,
    addr TEXT NOT NULL UNIQUE,
    n_events INTEGER DEFAULT 0,
    dur_sum_us REAL DEFAULT 0
);

CREATE TABLE events(
    id INTEGER PRIMARY KEY,
    ts REAL,
    dur REAL,
    ph TEXT,
    core_id INTEGER,
    pipe_id INTEGER,
    name_id INTEGER,
    code_id INTEGER,
    detail_id INTEGER,
    pc_id INTEGER
);

CREATE TABLE spans(
    id INTEGER PRIMARY KEY,
    core_id INTEGER,
    group_id TEXT,
    name_id INTEGER,
    pipe_id INTEGER,
    ts REAL,
    dur REAL
);

CREATE TABLE instructions(
    addr TEXT PRIMARY KEY,
    mnemonic TEXT,
    pipe TEXT,
    src TEXT,
    location_id INTEGER
);

CREATE TABLE instruction_core(
    addr TEXT,
    core_id INTEGER,
    calls INTEGER,
    cycles INTEGER,
    gpr INTEGER,
    process_bytes INTEGER,
    ub_read_conflict INTEGER,
    ub_write_conflict INTEGER,
    vector_util REAL,
    PRIMARY KEY(addr, core_id)
);

CREATE TABLE files(
    id INTEGER PRIMARY KEY,
    path TEXT NOT NULL UNIQUE,
    local_path TEXT,
    size INTEGER,
    n_lines INTEGER
);

CREATE TABLE file_lines(
    file_id INTEGER,
    line INTEGER,
    addr_ranges TEXT,
    cycles INTEGER,
    gpr INTEGER,
    instructions_executed INTEGER,
    process_bytes INTEGER,
    PRIMARY KEY(file_id, line)
);

CREATE TABLE timeline_hist(
    bucket_start_us REAL,
    pipe_id INTEGER,
    count INTEGER,
    dur_sum_us REAL
);

CREATE INDEX idx_events_core ON events(core_id);
CREATE INDEX idx_events_name ON events(name_id);
CREATE INDEX idx_events_code ON events(code_id);
CREATE INDEX idx_events_ts ON events(ts);
CREATE INDEX idx_spans_name ON spans(name_id);
CREATE INDEX idx_ic_addr ON instruction_core(addr);
CREATE INDEX idx_ic_core ON instruction_core(core_id);
CREATE INDEX idx_hist_bucket ON timeline_hist(bucket_start_us);

CREATE VIEW v_instruction AS
SELECT i.addr AS addr,
       i.mnemonic AS mnemonic,
       i.pipe AS pipe,
       i.src AS src,
       l.file AS file,
       l.line AS line,
       COALESCE((SELECT SUM(calls)  FROM instruction_core ic WHERE ic.addr=i.addr),0) AS calls,
       COALESCE((SELECT SUM(cycles) FROM instruction_core ic WHERE ic.addr=i.addr),0) AS cycles,
       COALESCE((SELECT COUNT(*)    FROM instruction_core ic WHERE ic.addr=i.addr),0) AS core_count,
       COALESCE(p.n_events,0)    AS trace_n,
       COALESCE(p.dur_sum_us,0)  AS trace_dur_us
FROM instructions i
LEFT JOIN locations l ON l.id = i.location_id
LEFT JOIN pcs p       ON p.addr = i.addr;

CREATE VIEW v_code_line AS
SELECT l.file AS file,
       l.line AS line,
       l.text AS loc,
       SUM(ic.calls)  AS calls,
       SUM(ic.cycles) AS cycles,
       COUNT(DISTINCT ic.core_id) AS core_count
FROM instructions i
JOIN instruction_core ic ON ic.addr = i.addr
JOIN locations l         ON l.id = i.location_id
GROUP BY i.location_id;

CREATE VIEW v_code_line_core AS
SELECT ic.core_id AS core_id,
       l.file AS file,
       l.line AS line,
       SUM(ic.calls)  AS calls,
       SUM(ic.cycles) AS cycles
FROM instructions i
JOIN instruction_core ic ON ic.addr = i.addr
JOIN locations l         ON l.id = i.location_id
GROUP BY ic.core_id, i.location_id;

CREATE VIEW v_exec_location AS
SELECT inner_file AS file,
       inner_line AS line,
       SUM(n_events)   AS n_events,
       SUM(dur_sum_us) AS dur_sum_us,
       COUNT(*)        AS stacks
FROM code_stacks
WHERE inner_file IS NOT NULL
GROUP BY inner_file, inner_line;

CREATE VIEW v_kernel_location AS
SELECT outer_file AS file,
       outer_line AS line,
       SUM(n_events)   AS n_events,
       SUM(dur_sum_us) AS dur_sum_us,
       COUNT(*)        AS stacks
FROM code_stacks
WHERE outer_file IS NOT NULL
GROUP BY outer_file, outer_line;
"""


