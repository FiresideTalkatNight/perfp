def sparkline(values):
    if not values:
        return ""
    blocks = "▁▂▃▄▅▆▇█"
    mx = max(values) or 1
    return "".join(blocks[min(7, int(v * 7.999 / mx))] for v in values)


def fmt_num(v, digits=2):
    if v is None:
        return "-"
    if isinstance(v, int):
        return f"{v:,}"
    return f"{v:,.{digits}f}"


def build_summary(db, out_dir, ctx, meta):
    cur = db.cursor()
    top_n = meta.get("top_n", 30)

    def rows(sql, params=()):
        return cur.execute(sql, params).fetchall()

    pipes = rows("SELECT name,n_events,dur_sum_us FROM pipes "
                 "ORDER BY dur_sum_us DESC")
    total_pipe_dur = sum(r[2] or 0 for r in pipes) or 1.0
    cores = rows("SELECT name,n_events,n_x,dur_sum_us,ts_min,ts_max FROM cores "
                 "ORDER BY dur_sum_us DESC")
    core_durs = [r[3] or 0 for r in cores]
    top_mnemonics = rows(
        "SELECT mnemonic,SUM(calls),SUM(cycles),SUM(trace_n),SUM(trace_dur_us) "
        "FROM v_instruction GROUP BY mnemonic "
        "ORDER BY SUM(trace_dur_us) DESC LIMIT ?", (top_n,))
    top_exec = rows("SELECT file,line,n_events,dur_sum_us FROM v_exec_location "
                    "ORDER BY dur_sum_us DESC LIMIT ?", (top_n,))
    top_kernel = rows("SELECT file,line,n_events,dur_sum_us FROM v_kernel_location "
                      "ORDER BY dur_sum_us DESC LIMIT ?", (top_n,))
    top_instr = rows(
        "SELECT addr,mnemonic,pipe,src,calls,cycles,trace_n,trace_dur_us "
        "FROM v_instruction ORDER BY trace_dur_us DESC LIMIT ?", (top_n,))
    top_lines = rows(
        "SELECT file,line,loc,calls,cycles FROM v_code_line "
        "ORDER BY cycles DESC LIMIT ?", (top_n,))
    hist = rows("SELECT bucket_start_us,SUM(count),SUM(dur_sum_us) "
                "FROM timeline_hist GROUP BY bucket_start_us "
                "ORDER BY bucket_start_us")
    busy = rows("SELECT bucket_start_us,SUM(count),SUM(dur_sum_us) "
                "FROM timeline_hist GROUP BY bucket_start_us "
                "ORDER BY SUM(count) DESC LIMIT 10")
    span_stats = rows(
        "SELECT n.name,COUNT(*),SUM(s.dur),MAX(s.dur) "
        "FROM spans s JOIN names n ON n.id=s.name_id "
        "GROUP BY s.name_id ORDER BY SUM(s.dur) DESC LIMIT 20")
    top_spans = rows(
        "SELECT n.name,c.name,s.ts,s.dur,s.group_id "
        "FROM spans s JOIN names n ON n.id=s.name_id "
        "JOIN cores c ON c.id=s.core_id ORDER BY s.dur DESC LIMIT 20")
    pipe_activity = rows(
        "SELECT core,pipe,segments,active_us,gap_count,gap_us,"
        "attributed_gap_us,unattributed_gap_us FROM v_pipe_activity "
        "ORDER BY gap_us DESC")
    top_gaps = rows(
        "SELECT id,core,pipe,ts,dur,before_name,after_name,before_file,"
        "before_line,after_file,after_line,attributed_us,unattributed_us,"
        "attributed_waits,status,peers FROM v_pipe_gap "
        "ORDER BY dur DESC LIMIT ?", (top_n,))
    wait_status = rows(
        "SELECT status,COUNT(*),SUM(wait_dur),SUM(COALESCE(delay_us,0)) "
        "FROM wait_attribution GROUP BY status ORDER BY COUNT(*) DESC")
    wait_by_producer = rows(
        "SELECT COALESCE(pp.name,''),COUNT(*),SUM(w.wait_dur),"
        "SUM(COALESCE(w.delay_us,0)),SUM(w.blocks_on_dma) "
        "FROM wait_attribution w LEFT JOIN pipes pp ON pp.id=w.producer_pipe_id "
        "GROUP BY w.producer_pipe_id ORDER BY SUM(COALESCE(w.delay_us,0)) DESC")
    wait_consumers = rows(
        "SELECT consumer_outer_file,consumer_outer_line,consumer_inner_file,"
        "consumer_inner_line,COUNT(*),SUM(wait_dur),"
        "SUM(COALESCE(delay_us,0)) FROM v_wait_attribution "
        "WHERE delay_us IS NOT NULL "
        "GROUP BY consumer_outer_file,consumer_outer_line,"
        "consumer_inner_file,consumer_inner_line "
        "ORDER BY SUM(COALESCE(delay_us,0)) DESC LIMIT ?", (top_n,))
    top_waits = rows(
        "SELECT core,consumer_pipe,consumer_inner_file,consumer_inner_line,"
        "consumer_outer_file,consumer_outer_line,wait_ts,wait_dur,"
        "producer_pipe,producer_inner_file,producer_inner_line,"
        "producer_outer_file,producer_outer_line,producer_end_ts,delay_us,"
        "slack_us,status,blocks_on_dma,gap_id FROM v_wait_attribution "
        "WHERE delay_us IS NOT NULL ORDER BY delay_us DESC LIMIT ?", (top_n,))
    dma_by_pipe = rows(
        "SELECT p.name,d.direction,COUNT(*),"
        "SUM(COALESCE(d.block_bytes,0)),"
        "SUM(CASE WHEN d.block_bytes IS NULL THEN 1 ELSE 0 END),"
        "SUM(COALESCE(d.overlap_us,0)),"
        "SUM(CASE WHEN d.classification='duplicate_candidate' THEN 1 ELSE 0 END) "
        "FROM dma_events d JOIN pipes p ON p.id=d.pipe_id "
        "GROUP BY d.pipe_id,d.direction ORDER BY 4 DESC")
    dma_by_instruction = rows(
        "SELECT addr,mnemonic,pipe,direction,file,line,outer_file,outer_line,"
        "events,bytes_inferred,min_block_bytes,max_block_bytes,overlap_us,"
        "duplicate_events FROM v_dma_instruction "
        "ORDER BY bytes_inferred DESC LIMIT ?", (top_n,))
    dma_by_kernel = rows(
        "SELECT file,line,pipe,direction,events,bytes_inferred,"
        "events_without_bytes,overlap_us,duplicate_events "
        "FROM v_dma_kernel_source ORDER BY bytes_inferred DESC LIMIT ?",
        (top_n,))
    dma_dups = rows(
        "SELECT addr,buffer_key,pipe,direction,file,line,outer_file,outer_line,"
        "events,block_bytes,bytes_inferred,first_ts,last_ts "
        "FROM v_dma_duplicate ORDER BY bytes_inferred DESC LIMIT ?", (top_n,))
    dma_totals = rows(
        "SELECT COUNT(*),SUM(COALESCE(block_bytes,0)),"
        "SUM(CASE WHEN block_bytes IS NULL THEN 1 ELSE 0 END),"
        "SUM(COALESCE(overlap_us,0)),"
        "COALESCE((SELECT SUM(cnt-1) FROM (SELECT COUNT(*) cnt "
        "FROM dma_events WHERE duplicate_count>1 GROUP BY duplicate_key)),0),"
        "COALESCE((SELECT SUM((cnt-1)*block) FROM (SELECT COUNT(*) cnt, "
        "MIN(block_bytes) block FROM dma_events WHERE duplicate_count>1 "
        "GROUP BY duplicate_key)),0),"
        "SUM(CASE WHEN classification='duplicate_candidate' THEN 1 ELSE 0 END) "
        "FROM dma_events")[0]
    gap_totals = rows(
        "SELECT COUNT(*),SUM(dur),SUM(attributed_us),SUM(unattributed_us) "
        "FROM pipe_gaps")[0]
    dma_gap_totals = rows(
        "SELECT COUNT(*),SUM(g.dur),SUM(g.attributed_us),"
        "SUM(g.unattributed_us) FROM pipe_gaps g JOIN pipes p ON p.id=g.pipe_id "
        "WHERE p.name IN ('MTE2','MTE3')")[0]
    wait_totals = rows(
        "SELECT COUNT(*),SUM(wait_dur),SUM(COALESCE(delay_us,0)),"
        "SUM(CASE WHEN blocks_on_dma=1 THEN COALESCE(delay_us,0) ELSE 0 END),"
        "SUM(CASE WHEN delay_us IS NULL THEN 1 ELSE 0 END) "
        "FROM wait_attribution")[0]
    ph_counts = ctx.ph_counts
    n_cores = len(cores)
    n_events = ctx.event_count
    ts_min = ctx.ts_min
    ts_max = ctx.ts_max
    wall = (ts_max - ts_min) if (ts_min is not None and ts_max is not None) else None
    coverage = ctx.ts_end - ts_min if ts_min is not None else None

    total_calls = q1(cur, "SELECT SUM(calls) FROM instruction_core") or 0
    total_cycles = q1(cur, "SELECT SUM(cycles) FROM instruction_core") or 0
    per_core_cycles = q1(cur, "SELECT MAX(c) FROM (SELECT SUM(cycles) c "
                              "FROM instruction_core GROUP BY core_id)") or 0
    x_events = sum(v for k, v in ph_counts.items() if k == "X")
    span_count = len(ctx.spans)
    accounted = x_events + span_count

    warnings = list(ctx.warnings)
    unmatched_begins = sum(len(v) for v in ctx.open_spans.values())
    instruction_rows = q1(cur, "SELECT COUNT(*) FROM instructions") or 0
    core_accounting = []
    for cid, name in cur.execute("SELECT id,name FROM cores ORDER BY id").fetchall():
        counter = q1(cur, "SELECT SUM(calls) FROM instruction_core WHERE core_id=?", (cid,))
        trace_count = q1(cur, "SELECT COUNT(*) FROM events WHERE core_id=? AND ph='X'", (cid,))
        trace_count += q1(cur, "SELECT COUNT(*) FROM spans WHERE core_id=?", (cid,))
        core_accounting.append({"core": name, "counter_calls": counter,
                                "trace_executions": trace_count,
                                "delta": trace_count - counter if counter is not None else None})
    quality = {
        "instruction_counters_available": bool(instruction_rows),
        "counter_calls": int(total_calls) if instruction_rows else None,
        "trace_executions": accounted,
        "execution_count_delta": accounted - total_calls if instruction_rows else None,
        "execution_count_delta_pct": 100 * (accounted - total_calls) / total_calls if total_calls else None,
        "per_core_accounting": core_accounting,
        "unmatched_sync_begins": unmatched_begins,
        "unmatched_sync_ends": ctx.unmatched_ends,
        "invalid_sync_spans": ctx.invalid_spans,
        "invalid_time_events": ctx.invalid_times,
        "x_events_without_source_stack": q1(cur, "SELECT COUNT(*) FROM events WHERE ph='X' AND code_id IS NULL"),
        "status": "ok",
    }
    missing_source = quality["x_events_without_source_stack"]
    quality["x_source_stack_coverage_pct"] = 100 * (x_events - missing_source) / x_events if x_events else None
    if missing_source:
        warnings.append(f"{missing_source} of {x_events} X events have no source stack; source-hotspot attribution is incomplete.")
    if not instruction_rows:
        warnings.append("Instruction counters are unavailable; execution-count reconciliation cannot be performed.")
    if unmatched_begins or ctx.unmatched_ends or ctx.invalid_spans:
        warnings.append(f"Incomplete synchronization data: {unmatched_begins} unmatched begins, "
                        f"{ctx.unmatched_ends} unmatched ends, {ctx.invalid_spans} invalid spans.")
    if ctx.invalid_times:
        warnings.append(f"{ctx.invalid_times} events contain invalid timestamps/durations; invalid values were excluded from time aggregates.")
    if wall and per_core_cycles and per_core_cycles / wall > 5000:
        warnings.append(
            f"`cycles` looks like simulator-internal accounting, not core "
            f"clock cycles: max per-core cycles={per_core_cycles:,} over "
            f"{wall:.1f}us implies {per_core_cycles / wall:,.0f} cycles/us. "
            f"Do not convert it to time; use events.dur for latency.")
    if wall and core_durs and (sum(core_durs) / max(n_cores, 1)) > wall * 1.2:
        warnings.append(
            "Accumulated per-core dur exceeds wall time: instruction "
            "latencies overlap across pipes, so SUM(dur) is not elapsed time.")
    if instruction_rows and accounted != total_calls:
        delta_pct = f"{100 * (accounted - total_calls) / total_calls:+.2f}%" if total_calls else "percentage unavailable: zero counter total"
        warnings.append(
            f"accounted executions (X events {x_events:,} + B/E spans "
            f"{span_count:,} = {accounted:,}) != summed instruction "
            f"executions ({int(total_calls):,}); delta={accounted - total_calls:+,} "
            f"({delta_pct}). "
            "Cause is unknown: counter semantics, mapping or parsing may differ; see quality.per_core_accounting.")
    if n_cores and min(core_durs) > 0:
        spread = max(core_durs) / min(core_durs)
        if spread > 1.05:
            warnings.append(f"Accumulated instruction-latency imbalance: max/min per-core SUM(dur) "
                            f"= {spread:.3f}; not execution-time imbalance.")
    if wait_totals[4]:
        warnings.append(f"{wait_totals[4]:,} WAIT spans have no matching producer or an "
                        "unresolved producer order; their delay is reported as unknown (NULL), not zero.")
    if dma_totals[2]:
        warnings.append(f"{dma_totals[2]:,} of {dma_totals[0]:,} DMA events have no byte estimate; "
                        "sums are lower bounds and `device_measured_bytes` stays null.")
    if dma_totals[6]:
        warnings.append(f"{dma_totals[6]:,} DMA events are duplicate candidates (same PC and normalized "
                        "detail). This is a heuristic, not proof that the data was useless or avoidable.")
    if gap_totals[0]:
        warnings.append(f"{gap_totals[3] or 0:.2f} us of pipe idle gaps are unattributed; "
                        "they are unknown, not proven harmless or proven blocking.")

    if (not instruction_rows or (instruction_rows and accounted != total_calls)
            or unmatched_begins or ctx.unmatched_ends or ctx.invalid_spans or ctx.invalid_times or missing_source):
        quality["status"] = "caution"

    summary = {
        "perfp_version": VERSION,
        "schema_version": SCHEMA_VERSION,
        "input": meta.get("input"),
        "input_sha256": meta.get("input_sha256"),
        "bin_size": meta.get("bin_size"),
        "records": meta.get("records"),
        "case": meta.get("case"),
        "trace": {
            "events": n_events,
            "ph": dict(ph_counts),
            "cores": n_cores,
            "ts_min": ts_min,
            "ts_max": ts_max,
            "wall_us": wall,
            "event_start_range_us": wall,
            "event_coverage_us": coverage,
            "event_end_max_us": ctx.ts_end,
            "device_task_duration_us": None,
            "code_stacks": len(ctx.stacks.items),
            "locations": len(ctx.locations.items),
            "details": len(ctx.details.items),
            "pcs": len(ctx.pcs.items),
            "x_events": x_events,
            "sync_spans": span_count,
            "accounted_executions": accounted,
        },
        "pipes": [
            {"name": r[0], "n_events": r[1], "dur_sum_us": r[2],
             "share": (r[2] or 0) / total_pipe_dur}
            for r in pipes
        ],
        "cores": {
            "count": n_cores,
            "dur_sum_us": {
                "min": min(core_durs) if core_durs else None,
                "max": max(core_durs) if core_durs else None,
                "mean": (sum(core_durs) / n_cores) if n_cores else None,
            },
            "table": [
                {"name": r[0], "n_events": r[1], "n_x": r[2],
                 "dur_sum_us": r[3]} for r in cores
            ],
        },
        "top_mnemonics": [
            {"mnemonic": r[0], "calls": r[1], "cycles": r[2],
             "trace_n": r[3], "trace_dur_us": r[4]} for r in top_mnemonics
        ],
        "top_exec_locations": [
            {"file": r[0], "line": r[1], "n_events": r[2],
             "dur_sum_us": r[3]} for r in top_exec
        ],
        "top_kernel_locations": [
            {"file": r[0], "line": r[1], "n_events": r[2],
             "dur_sum_us": r[3]} for r in top_kernel
        ],
        "top_instructions": [
            {"addr": r[0], "mnemonic": r[1], "pipe": r[2], "src": r[3],
             "calls": r[4], "cycles": r[5], "trace_n": r[6],
             "trace_dur_us": r[7]} for r in top_instr
        ],
        "top_code_lines": [
            {"file": r[0], "line": r[1], "loc": r[2], "calls": r[3],
             "cycles": r[4]} for r in top_lines
        ],
        "total_instruction_executions": int(total_calls),
        "total_cycles": int(total_cycles),
        "sync_spans": {
            "count": sum(r[1] for r in span_stats),
            "by_name": [
                {"name": r[0], "count": r[1], "dur_sum": r[2],
                 "dur_max": r[3]} for r in span_stats
            ],
        },
        "pipe_activity": [
            {"core": r[0], "pipe": r[1], "segments": r[2],
             "active_us": r[3], "gap_count": r[4], "gap_us": r[5],
             "attributed_gap_us": r[6],
             "unattributed_gap_us": r[7]} for r in pipe_activity
        ],
        "pipe_gaps": {
            "threshold_us": meta.get("gap_us"),
            "count": gap_totals[0] or 0,
            "gap_us": gap_totals[1] or 0.0,
            "attributed_us": gap_totals[2] or 0.0,
            "unattributed_us": gap_totals[3] or 0.0,
            "dma_gap_count": dma_gap_totals[0] or 0,
            "dma_gap_us": dma_gap_totals[1] or 0.0,
            "dma_attributed_us": dma_gap_totals[2] or 0.0,
            "dma_unattributed_us": dma_gap_totals[3] or 0.0,
            "top": [
                {"id": r[0], "core": r[1], "pipe": r[2], "ts": r[3],
                 "dur_us": r[4], "before_name": r[5], "after_name": r[6],
                 "before_file": r[7], "before_line": r[8],
                 "after_file": r[9], "after_line": r[10],
                 "attributed_us": r[11], "unattributed_us": r[12],
                 "attributed_waits": r[13], "status": r[14],
                 "peers": r[15]} for r in top_gaps
            ],
        },
        "waits": {
            "count": wait_totals[0] or 0,
            "wait_us": wait_totals[1] or 0.0,
            "attributed_delay_us": wait_totals[2] or 0.0,
            "dma_delay_us": wait_totals[3] or 0.0,
            "unattributed_count": wait_totals[4] or 0,
            "by_status": [
                {"status": r[0], "count": r[1], "wait_us": r[2],
                 "delay_us": r[3]} for r in wait_status
            ],
            "by_producer_pipe": [
                {"pipe": r[0], "count": r[1], "wait_us": r[2],
                 "delay_us": r[3], "on_dma": r[4]} for r in wait_by_producer
            ],
            "by_consumer_source": [
                {"outer_file": r[0], "outer_line": r[1],
                 "inner_file": r[2], "inner_line": r[3], "count": r[4],
                 "wait_us": r[5], "delay_us": r[6]} for r in wait_consumers
            ],
            "top": [
                {"core": r[0], "consumer_pipe": r[1],
                 "consumer_inner_file": r[2], "consumer_inner_line": r[3],
                 "consumer_outer_file": r[4], "consumer_outer_line": r[5],
                 "wait_ts": r[6], "wait_us": r[7], "producer_pipe": r[8],
                 "producer_inner_file": r[9], "producer_inner_line": r[10],
                 "producer_outer_file": r[11], "producer_outer_line": r[12],
                 "producer_end_ts": r[13], "delay_us": r[14],
                 "slack_us": r[15], "status": r[16],
                 "blocks_on_dma": r[17], "gap_id": r[18]} for r in top_waits
            ],
        },
        "dma": {
            "pipes": list(DMA_PIPES),
            "events": dma_totals[0] or 0,
            "bytes_inferred": dma_totals[1] or 0.0,
            "events_without_bytes": dma_totals[2] or 0,
            "overlap_us": dma_totals[3] or 0.0,
            "duplicate_excess_events": dma_totals[4] or 0,
            "duplicate_excess_bytes": dma_totals[5] or 0.0,
            "duplicate_candidate_events": dma_totals[6] or 0,
            "device_measured_bytes": None,
            "bytes_source": "instruction Process Bytes / detail text; estimated, not measured traffic",
            "by_pipe": [
                {"pipe": r[0], "direction": r[1], "events": r[2],
                 "bytes_inferred": r[3], "events_without_bytes": r[4],
                 "overlap_us": r[5], "duplicate_events": r[6]}
                for r in dma_by_pipe
            ],
            "by_instruction": [
                {"addr": r[0], "mnemonic": r[1], "pipe": r[2],
                 "direction": r[3], "file": r[4], "line": r[5],
                 "outer_file": r[6], "outer_line": r[7], "events": r[8],
                 "bytes_inferred": r[9], "min_block_bytes": r[10],
                 "max_block_bytes": r[11], "overlap_us": r[12],
                 "duplicate_events": r[13]} for r in dma_by_instruction
            ],
            "by_kernel_source": [
                {"file": r[0], "line": r[1], "pipe": r[2],
                 "direction": r[3], "events": r[4],
                 "bytes_inferred": r[5], "events_without_bytes": r[6],
                 "overlap_us": r[7], "duplicate_events": r[8]}
                for r in dma_by_kernel
            ],
            "duplicate_candidates": [
                {"addr": r[0], "buffer_key": r[1], "pipe": r[2],
                 "direction": r[3], "file": r[4], "line": r[5],
                 "outer_file": r[6], "outer_line": r[7], "events": r[8],
                 "block_bytes": r[9], "bytes_inferred": r[10],
                 "first_ts": r[11], "last_ts": r[12]} for r in dma_dups
            ],
        },
        "warnings": warnings,
        "quality": quality,
        "metric_semantics": {
            "wall_us": "Deprecated alias of event_start_range_us; not kernel elapsed time.",
            "event_start_range_us": "MAX(ts)-MIN(ts), excluding metadata events.",
            "event_coverage_us": "MAX(X.ts+X.dur, other.ts)-MIN(ts), excluding metadata; simulator event extent, not device task duration.",
            "dur_sum_us": "Accumulated instruction latency; overlapping across instructions/pipes/cores, not utilization or critical-path time.",
            "share": "Share of accumulated instruction latency, not fraction of elapsed time.",
            "cycles": "Producer counter with unverified clock semantics; do not convert to microseconds.",
            "device_task_duration_us": "Unavailable from this simulator trace; null, never inferred.",
            "pipe_gaps": "Simulator-timeline idle intervals per core+pipe, measured against X-event activity. A gap is not proof of a bottleneck.",
