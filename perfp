def _load_bundle(path):
    path = os.path.abspath(os.path.expanduser(path))
    sp = os.path.join(path, "summary.json")
    if not os.path.isfile(sp):
        raise PerfpError(
            f"{path} is not a perfp bundle (missing summary.json); run "
            "`perfp <input> -o <bundle>` first")
    with open(sp, encoding="utf-8") as f:
        summary = json.load(f)
    db = None
    dp = os.path.join(path, "profile.sqlite")
    if os.path.isfile(dp):
        db = sqlite3.connect(dp)
    return summary, db, path


def _bundle_rows(db, sql):
    if db is None:
        return []
    try:
        return db.execute(sql).fetchall()
    except sqlite3.Error:
        return []


def _delta(a, b):
    if a is None or b is None:
        return None, None
    d = b - a
    pct = (100.0 * d / a) if a else None
    return d, pct


def _metric(a, b):
    d, pct = _delta(a, b)
    return {"a": a, "b": b, "delta": d, "delta_pct": pct}


def _fmt_delta(v, digits=2, suffix=""):
    if v is None:
        return "-"
    return f"{v:+.{digits}f}{suffix}"


def compare(args):
    global QUIET
    QUIET = bool(getattr(args, "quiet", False))
    sa, dba, pa = _load_bundle(args.a)
    sb, dbb, pb = _load_bundle(args.b)
    label_a = args.label_a or os.path.basename(pa.rstrip("/")) or "A"
    label_b = args.label_b or os.path.basename(pb.rstrip("/")) or "B"

    def m(summary, path, default=None):
        cur = summary
        for key in path:
            if not isinstance(cur, dict) or key not in cur:
                return default
            cur = cur[key]
        return cur

    def metric(name, path, default=0):
        return _metric(m(sa, path, default), m(sb, path, default))

    metrics = {
        "event_coverage_us": metric("event_coverage_us",
                                    ("trace", "event_coverage_us")),
        "dma_bytes_inferred": metric("dma_bytes_inferred",
                                     ("dma", "bytes_inferred")),
        "dma_events": metric("dma_events", ("dma", "events")),
        "dma_overlap_us": metric("dma_overlap_us", ("dma", "overlap_us")),
        "dma_duplicate_excess_bytes": metric(
            "dma_duplicate_excess_bytes", ("dma", "duplicate_excess_bytes")),
        "wait_us": metric("wait_us", ("waits", "wait_us")),
        "wait_delay_us": metric("wait_delay_us",
                                ("waits", "attributed_delay_us")),
        "wait_on_dma_us": metric("wait_on_dma_us", ("waits", "dma_delay_us")),
        "dma_gap_us": metric("dma_gap_us", ("pipe_gaps", "dma_gap_us")),
        "dma_gap_attributed_us": metric(
            "dma_gap_attributed_us", ("pipe_gaps", "dma_attributed_us")),
        "dma_gap_unattributed_us": metric(
            "dma_gap_unattributed_us", ("pipe_gaps", "dma_unattributed_us")),
    }

    dev_a = args.device_us_a
    dev_b = args.device_us_b
    dev_source = "cli" if dev_a is not None or dev_b is not None else "bundle"
    if dev_a is None:
        dev_a = m(sa, ("trace", "device_task_duration_us"))
    if dev_b is None:
        dev_b = m(sb, ("trace", "device_task_duration_us"))
    metrics["device_task_duration_us"] = _metric(dev_a, dev_b)

    # Stage alignment by exact kernel source line.  Line numbers may shift
    # between revisions; the JSON keeps the raw keys so callers can re-align.
    def stage_map(db):
        dma = defaultdict(lambda: {"dma_events": 0, "dma_bytes": 0.0,
                                   "dma_overlap_us": 0.0,
                                   "duplicate_events": 0})
        for f, line, events, byt, overlap, dup in _bundle_rows(
                db, "SELECT file,line,SUM(events),SUM(bytes_inferred),"
                    "SUM(overlap_us),SUM(duplicate_events) "
                    "FROM v_dma_kernel_source GROUP BY file,line"):
            key = (f or "(unknown)", line)
            dma[key]["dma_events"] += events or 0
            dma[key]["dma_bytes"] += byt or 0.0
            dma[key]["dma_overlap_us"] += overlap or 0.0
            dma[key]["duplicate_events"] += dup or 0
        waits = defaultdict(lambda: {"waits": 0, "wait_us": 0.0,
                                     "delay_us": 0.0})
        for f, line, count, wait, delay in _bundle_rows(
                db, "SELECT consumer_outer_file,consumer_outer_line,"
                    "COUNT(*),SUM(wait_dur),SUM(COALESCE(delay_us,0)) "
                    "FROM v_wait_attribution "
                    "GROUP BY consumer_outer_file,consumer_outer_line"):
            key = (f or "(unknown)", line)
            waits[key]["waits"] += count or 0
            waits[key]["wait_us"] += wait or 0.0
            waits[key]["delay_us"] += delay or 0.0
        out = {}
        for key in set(dma) | set(waits):
            v = {"dma_events": 0, "dma_bytes": 0.0, "dma_overlap_us": 0.0,
                 "duplicate_events": 0, "waits": 0, "wait_us": 0.0,
                 "delay_us": 0.0}
            v.update(dma.get(key, {}))
            v.update(waits.get(key, {}))
            out[key] = v
        return out

    sa_map = stage_map(dba)
    sb_map = stage_map(dbb)
    stages = []
    for key in sorted(set(sa_map) | set(sb_map)):
        a = sa_map.get(key, {})
        b = sb_map.get(key, {})
        d_bytes, p_bytes = _delta(a.get("dma_bytes", 0.0),
                                  b.get("dma_bytes", 0.0))
        d_delay, p_delay = _delta(a.get("delay_us", 0.0),
                                  b.get("delay_us", 0.0))
        stages.append({
            "file": key[0], "line": key[1],
            "a": a, "b": b,
            "delta_dma_bytes": d_bytes, "delta_dma_bytes_pct": p_bytes,
            "delta_delay_us": d_delay, "delta_delay_pct": p_delay,
        })
    stages.sort(key=lambda r: (abs(r["delta_dma_bytes"] or 0.0)
                               + abs(r["delta_delay_us"] or 0.0)), reverse=True)
    stages = stages[:args.top]

    def pipe_rows(db, sql):
        return _bundle_rows(db, sql)

    dma_pipe_a = {r[0] + "/" + r[1]: r for r in pipe_rows(
        dba, "SELECT pipe,direction,SUM(events),SUM(bytes_inferred),"
             "SUM(overlap_us) FROM v_dma_source GROUP BY pipe,direction")}
    dma_pipe_b = {r[0] + "/" + r[1]: r for r in pipe_rows(
        dbb, "SELECT pipe,direction,SUM(events),SUM(bytes_inferred),"
             "SUM(overlap_us) FROM v_dma_source GROUP BY pipe,direction")}
    dma_pipes = []
    for key in sorted(set(dma_pipe_a) | set(dma_pipe_b)):
        a = dma_pipe_a.get(key, ("", "", 0, 0.0, 0.0))
        b = dma_pipe_b.get(key, ("", "", 0, 0.0, 0.0))
        d_bytes, _ = _delta(a[3], b[3])
        dma_pipes.append({"pipe": a[0] or b[0], "direction": a[1] or b[1],
                          "a_events": a[2], "b_events": b[2],
                          "a_bytes": a[3], "b_bytes": b[3],
                          "delta_bytes": d_bytes,
                          "a_overlap_us": a[4], "b_overlap_us": b[4]})

    wait_pipe_a = {r[0]: r for r in pipe_rows(
        dba, "SELECT COALESCE(producer_pipe,''),COUNT(*),SUM(wait_dur),"
             "SUM(COALESCE(delay_us,0)) FROM v_wait_attribution "
             "GROUP BY producer_pipe")}
    wait_pipe_b = {r[0]: r for r in pipe_rows(
        dbb, "SELECT COALESCE(producer_pipe,''),COUNT(*),SUM(wait_dur),"
             "SUM(COALESCE(delay_us,0)) FROM v_wait_attribution "
             "GROUP BY producer_pipe")}
    wait_pipes = []
    for key in sorted(set(wait_pipe_a) | set(wait_pipe_b)):
        a = wait_pipe_a.get(key, ("", 0, 0.0, 0.0))
        b = wait_pipe_b.get(key, ("", 0, 0.0, 0.0))
        d, _ = _delta(a[3], b[3])
        wait_pipes.append({"producer_pipe": a[0] or b[0],
                           "a_waits": a[1], "b_waits": b[1],
                           "a_delay_us": a[3], "b_delay_us": b[3],
                           "delta_delay_us": d})

    result = {
        "perfp_version": VERSION,
        "schema_version": SCHEMA_VERSION,
        "a": {"label": label_a, "bundle": pa, "input": sa.get("input")},
        "b": {"label": label_b, "bundle": pb, "input": sb.get("input")},
        "device_task_timing": {"source": dev_source,
                               "a_us": dev_a, "b_us": dev_b,
                               "delta_us": _delta(dev_a, dev_b)[0],
                               "delta_pct": _delta(dev_a, dev_b)[1]},
        "metrics": metrics,
        "dma_by_pipe": dma_pipes,
        "waits_by_producer_pipe": wait_pipes,
        "stage_alignment": stages,
        "notes": [
            "Stage alignment is by exact kernel source file:line. Line shifts between revisions are not auto-matched.",
            "DMA bytes are instruction-derived estimates; device_measured_bytes is not available from simulator input.",
            "delay_us and pipe gaps are simulator-timeline values; device timing must be supplied separately.",
        ],
    }

    out_dir = prepare_out(args.out, args.force)
    with open(os.path.join(out_dir, "compare.json"), "w", encoding="utf-8") as f:
        json.dump(result, f, indent=2, ensure_ascii=False)

    L = [f"# perfp A/B comparison — {label_a} vs {label_b}", ""]
    L.append(f"- A: `{pa}`")
    L.append(f"- B: `{pb}`")
    if dev_a is not None or dev_b is not None:
        L.append(f"- device task duration source: **{dev_source}**")
    else:
        L.append("- device task duration: **unavailable** (pass `--device-us-a/b`)")
    L += ["", "## Headline metrics", "",
          f"| metric | {label_a} | {label_b} | delta | delta % |",
          "|---|---:|---:|---:|---:|"]
    labels = {
        "event_coverage_us": "event coverage (us, not device time)",
        "device_task_duration_us": "device task duration (us)",
        "dma_bytes_inferred": "DMA bytes (estimated)",
        "dma_events": "DMA events",
        "dma_overlap_us": "DMA/compute overlap (us, per-event sum)",
        "dma_duplicate_excess_bytes": "duplicate-candidate excess bytes",
        "wait_us": "WAIT span total (us)",
        "wait_delay_us": "attributable wait delay (us)",
        "wait_on_dma_us": "wait delay on DMA producer (us)",
        "dma_gap_us": "MTE2/MTE3 idle gaps (us)",
        "dma_gap_attributed_us": "DMA gaps attributed to waits (us)",
        "dma_gap_unattributed_us": "DMA gaps unattributed/unknown (us)",
    }
    for key, lab in labels.items():
        r = metrics[key]
        pct = "-" if r["delta_pct"] is None else f"{r['delta_pct']:+.1f}%"
        L.append(f"| {lab} | {fmt_num(r['a'])} | {fmt_num(r['b'])} | "
                 f"{_fmt_delta(r['delta'])} | {pct} |")
    L += ["", "## DMA by pipe", "",
          f"| pipe | dir | {label_a} events | {label_b} events | {label_a} bytes | {label_b} bytes | delta bytes |",
          "|---|---|---:|---:|---:|---:|---:|"]
    for r in dma_pipes:
        L.append(f"| {r['pipe']} | {r['direction']} | {r['a_events']:,} | "
                 f"{r['b_events']:,} | {fmt_num(r['a_bytes'])} | "
                 f"{fmt_num(r['b_bytes'])} | {_fmt_delta(r['delta_bytes'])} |")
    L += ["", "## Wait delay by producer pipe", "",
          "| producer pipe | A waits | B waits | A delay_us | B delay_us | delta delay_us |",
          "|---|---:|---:|---:|---:|---:|"]
    for r in wait_pipes:
        L.append(f"| {r['producer_pipe'] or '(unknown)'} | {r['a_waits']:,} | "
                 f"{r['b_waits']:,} | {fmt_num(r['a_delay_us'])} | "
                 f"{fmt_num(r['b_delay_us'])} | {_fmt_delta(r['delta_delay_us'])} |")
    L += ["", "## Stage alignment (exact kernel source line)", "",
          "| file | line | A DMA bytes | B DMA bytes | delta bytes | A delay_us | B delay_us | delta delay_us |",
          "|---|---:|---:|---:|---:|---:|---:|---:|"]
    for r in stages:
        L.append(f"| {r['file']} | {r['line'] if r['line'] is not None else '-'} | "
                 f"{fmt_num(r['a'].get('dma_bytes'))} | "
                 f"{fmt_num(r['b'].get('dma_bytes'))} | "
                 f"{_fmt_delta(r['delta_dma_bytes'])} | "
                 f"{fmt_num(r['a'].get('delay_us'))} | "
                 f"{fmt_num(r['b'].get('delay_us'))} | "
                 f"{_fmt_delta(r['delta_delay_us'])} |")
    L += ["", "## Notes", ""] + [f"- {n}" for n in result["notes"]] + [""]
    with open(os.path.join(out_dir, "compare.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(L))
    for db in (dba, dbb):
        if db is not None:
            db.close()
    eprint(f"[perfp] compare -> {out_dir}/compare.md")
    return 0


# --------------------------------------------------------------------------
# info
# --------------------------------------------------------------------------

def info(args):
    bin_path = find_bin(args.input)
    size = os.path.getsize(bin_path)
    recs = []
    with open(bin_path, "rb") as f:
        for rec in iter_records(f, size):
            f.seek(rec.payload)
            head = f.read(min(48, rec.length))
            recs.append((rec, head))

    if args.json:
        out = []
        for rec, head in recs:
            out.append({
                "index": rec.index,
                "offset": rec.offset,
                "length": rec.length,
                "type": rec.type,
                "subtype": rec.subtype,
                "head": head.decode("utf-8", "replace"),
            })
        print(json.dumps({"path": bin_path, "size": size, "records": out},
                         indent=2))
        return 0

    print(f"{bin_path}  ({human(size)})")
    print(f"{'idx':>3} {'offset':>12} {'length':>12} {'type':>4} {'sub':>4}  head")
    for rec, head in recs:
        text = head.decode("utf-8", "replace").replace("\n", " ")[:40]
        print(f"{rec.index:>3} {rec.offset:>12} {rec.length:>12} "
              f"{rec.type:>4} {rec.subtype:>4}  {text}")
    by_type = Counter(r.type for r, _ in recs)
    total = sum(1 for _ in recs)
    print(f"\n{total} records; by type: "
          + ", ".join(f"{t}:{n}" for t, n in sorted(by_type.items())))
    return 0


# --------------------------------------------------------------------------
# main
# --------------------------------------------------------------------------

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # Allow `perfp <input> ...` as a shorthand for `perfp build <input> ...`.
    if argv and argv[0] not in ("build", "info", "compare", "-h", "--help",
                                "--version"):
        argv = ["build"] + argv

    ap = argparse.ArgumentParser(
        prog="perfp",
        description="preprocess Ascend simulator visualize_data.bin into an "
                    "agent-friendly SQLite + summary + CSV bundle",
        epilog="examples:\n"
               "  perfp /data/smoke_p03 -o perfp_out\n"
               "  perfp build /data/OPPROF_*/simulator/visualize_data.bin "
               "-o out --force\n"
               "  perfp info /data/smoke_p03\n"
               "  perfp compare out_a out_b -o compare_out\n",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"perfp {VERSION}")

    sub = ap.add_subparsers(dest="cmd")

    b = sub.add_parser("build", help="build the analysis bundle (default)")
    b.add_argument("input", help="bin file, OPPROF dir, or case dir")
    b.add_argument("-o", "--out", default="perfp_out",
                   help="output directory (default: perfp_out)")
    b.add_argument("--bucket-us", type=float, default=0.5,
                   help="timeline histogram bucket in us (default: 0.5)")
    b.add_argument("--gap-us", type=float, default=DEFAULT_GAP_US,
                   help="minimum pipe idle gap to report in us "
                        f"(default: {DEFAULT_GAP_US})")
    b.add_argument("--top", type=int, default=30,
                   help="number of rows in top-N tables (default: 30)")
    b.add_argument("--force", action="store_true",
                   help="replace a non-empty output directory")
    b.add_argument("--no-raw", action="store_true",
                   help="do not keep the raw timeline")
    b.add_argument("--raw-plain", action="store_true",
                   help="keep raw timeline as plain trace.json (not .gz)")
    b.add_argument("--no-src", action="store_true",
                   help="do not extract embedded sources")
    b.add_argument("--no-events-csv", action="store_true",
                   help="skip the full events.csv(.gz) export")
    b.add_argument("--events-csv-plain", action="store_true",
                   help="write events.csv instead of events.csv.gz")
    b.add_argument("--quiet", action="store_true")
    b.add_argument("--all", action="store_true", help="process every visualize_data.bin in a directory and write a batch index")

    c = sub.add_parser("compare",
                       help="align two perfp bundles and compare DMA/wait metrics")
    c.add_argument("a", help="baseline perfp bundle directory")
    c.add_argument("b", help="candidate perfp bundle directory")
    c.add_argument("-o", "--out", default="perfp_compare",
                   help="output directory (default: perfp_compare)")
    c.add_argument("--label-a", help="display label for A")
    c.add_argument("--label-b", help="display label for B")
    c.add_argument("--device-us-a", type=float,
                   help="independent device task duration for A, in us")
    c.add_argument("--device-us-b", type=float,
                   help="independent device task duration for B, in us")
    c.add_argument("--top", type=int, default=30,
                   help="number of stage rows to report (default: 30)")
    c.add_argument("--force", action="store_true",
                   help="replace a non-empty output directory")
    c.add_argument("--quiet", action="store_true")

    i = sub.add_parser("info", help="show the container record table")
    i.add_argument("input")
    i.add_argument("--json", action="store_true")

    args = ap.parse_args(argv)

    if args.cmd == "build":
        if not math.isfinite(args.bucket_us) or args.bucket_us <= 0:
            ap.error("--bucket-us must be finite and greater than zero")
        if not math.isfinite(args.gap_us) or args.gap_us < 0:
            ap.error("--gap-us must be finite and non-negative")
        if args.top <= 0:
            ap.error("--top must be greater than zero")
        return build_all(args) if args.all else build(args)
    if args.cmd == "compare":
        if args.top <= 0:
            ap.error("--top must be greater than zero")
        return compare(args)
    if args.cmd == "info":
        return info(args)
    ap.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except PerfpError as e:
        eprint(f"perfp: error: {e}")
        sys.exit(1)
    except KeyboardInterrupt:
        eprint("perfp: interrupted")
        sys.exit(130)
