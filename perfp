VERSION = "0.1.0"
SCHEMA_VERSION = 1

REC_HDR = struct.Struct("<IIBB2s")
TYPE_SOURCE = 1
TYPE_TRACE = 2
TYPE_FILES = 3
TYPE_INSTRUCTIONS = 4
PAD_TYPE1 = 4096
EVENT_BATCH = 20000


# --------------------------------------------------------------------------
# errors / small helpers
# --------------------------------------------------------------------------

class PerfpError(Exception):
    pass


QUIET = False


def eprint(*args):
    if not QUIET:
        print(*args, file=sys.stderr)


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if abs(n) < 1024.0 or unit == "GB":
            return f"{n:.1f}{unit}" if unit != "B" else f"{int(n)}B"
        n /= 1024.0


def split_loc(text):
    """'a/b.h:123' -> ('a/b.h', 123); ('a/b.h', None) when no line number."""
    if not text:
        return (None, None)
    p, sep, ln = text.rpartition(":")
    if sep and ln.isdigit():
        return (p, int(ln))
    return (text, None)


def safe_relpath(path):
    """Make an absolute embedded source path safe to write under src/."""
    p = os.path.normpath("/" + path.lstrip("/")).lstrip("/")
    if not p or p.startswith(".."):
        p = re.sub(r"[^A-Za-z0-9._-]+", "_", path)
    return p


def q1(cur, sql, params=(), default=None):
    row = cur.execute(sql, params).fetchone()
    if row is None:
        return default
    return row[0]


# --------------------------------------------------------------------------
# container reader
# --------------------------------------------------------------------------

class Record:
    __slots__ = ("index", "offset", "length", "type", "subtype", "payload")

    def __init__(self, index, offset, length, typ, subtype, payload):
        self.index = index
        self.offset = offset
        self.length = length
        self.type = typ
        self.subtype = subtype
        self.payload = payload

    def __repr__(self):
        return (f"Record(#{self.index} off={self.offset} len={self.length} "
                f"type={self.type} sub={self.subtype})")


def iter_records(f, size):
    """Yield Record objects by walking the container. Rewinds ``f`` as needed."""
    pos = 0
    idx = 0
    while pos + 12 <= size:
        f.seek(pos)
        head = f.read(12)
        if len(head) < 12:
            raise PerfpError(f"truncated record header at offset {pos}")
        length, reserved, typ, subtype, magic = REC_HDR.unpack(head)
        if magic[-1] != 0x5A:
            raise PerfpError(
                f"bad record magic at offset {pos}: {head.hex(' ')} "
                "(not a visualize_data.bin container?)"
            )
        payload = pos + 12
        if payload + length > size:
            raise PerfpError(
                f"record #{idx} at {pos} claims {length} bytes, "
                f"but only {size - payload} remain"
            )
        yield Record(idx, pos, length, typ, subtype, payload)
        pos = payload + length + (PAD_TYPE1 if typ == TYPE_SOURCE else 0)
        idx += 1

    if pos != size:
        raise PerfpError(
            f"container walk ended at {pos}, file size is {size} "
            f"({size - pos} stray bytes)"
        )


def find_bin(path):
    path = os.path.abspath(os.path.expanduser(path))
    if os.path.isfile(path):
        return path
    if not os.path.isdir(path):
        raise PerfpError(f"no such file or directory: {path}")
    cands = sorted(glob.glob(os.path.join(path, "**", "visualize_data.bin"),
                             recursive=True))
    if not cands:
        cands = sorted(glob.glob(os.path.join(path, "**", "*.bin"),
                                 recursive=True))
    if not cands:
        raise PerfpError(f"could not find visualize_data.bin under {path}")
    if len(cands) > 1:
        eprint(f"[perfp] warning: {len(cands)} candidates, using {cands[0]}")
    return cands[0]


# --------------------------------------------------------------------------
# dictionaries
# --------------------------------------------------------------------------

class Interner:
    __slots__ = ("kind", "ids", "items")

    def __init__(self, kind):
        self.kind = kind
        self.ids = {}
        self.items = []

    def get(self, value):
        i = self.ids.get(value)
        if i is None:
            i = len(self.items)
            self.ids[value] = i
            self.items.append(value)
        return i


class Ctx:
    def __init__(self):
        self.cores = Interner("cores")
        self.pipes = Interner("pipes")
        self.names = Interner("names")
        self.stacks = Interner("code_stacks")
        self.details = Interner("details")
        self.pcs = Interner("pcs")
        self.locations = Interner("locations")

        self.core_stats = {}      # cid -> [n, n_x, dur_sum, ts_min, ts_max]
        self.pipe_stats = {}      # pid -> [n, dur_sum]
        self.name_stats = {}      # nid -> [n, n_x, dur_sum]
        self.stack_stats = {}     # sid -> [n, dur_sum]
        self.pc_stats = {}        # pcid -> [n, dur_sum]
        self.stack_meta = {}      # sid -> (inner_file, inner_line, outer_file, outer_line)
        self.sort_index = {}      # cid -> int

        self.hist = defaultdict(lambda: [0, 0.0])   # (bucket_idx, pid) -> [n, dur]
        self.spans = []                            # (core_id, group, name_id, pipe_id, ts, dur)
        self.open_spans = {}
        self.top_events = []
        self.ph_counts = Counter()
        self.event_count = 0
        self.ts_min = None
        self.ts_max = None
        self.source_local = {}    # original path -> relative file under src/
        self.warnings = []


def bump2(d, key, n=1, dur=0.0):
    v = d.get(key)
    if v is None:
        d[key] = [n, dur]
    else:
        v[0] += n
        v[1] += dur


# --------------------------------------------------------------------------
# trace ingestion
# --------------------------------------------------------------------------

def _iter_trace_events(s):
    marker = s.find('"traceEvents"')
    if marker < 0:
        raise PerfpError('trace record has no "traceEvents" array')
    start = s.find("[", marker)
    if start < 0:
        raise PerfpError('malformed "traceEvents" array')
    i = start + 1
    n = len(s)
    dec = json.JSONDecoder()
    while True:
        while i < n and s[i] in " \t\r\n,":
            i += 1
        if i >= n:
            raise PerfpError("unexpected end of trace JSON")
        if s[i] == "]":
            return
        obj, i = dec.raw_decode(s, i)
        yield obj


def ingest_trace(payload, ctx, db, bucket_us, top_n):
    s = payload.decode("utf-8", "replace")
    del payload

    cur = db.cursor()
    ev_rows = []
    eid = 0
    t0 = time.time()

    for obj in _iter_trace_events(s):
        if not isinstance(obj, dict):
            continue
        ctx.event_count += 1

        ph = obj.get("ph")
        if not isinstance(ph, str):
            ph = "" if ph is None else str(ph)

        raw_ts = obj.get("ts")
        ts = raw_ts if isinstance(raw_ts, (int, float)) else None
        raw_dur = obj.get("dur")
        dur = raw_dur if isinstance(raw_dur, (int, float)) else None

        pid_raw = obj.get("pid")
        tid_raw = obj.get("tid")
        name_raw = obj.get("name")
        cid = ctx.cores.get("" if pid_raw is None else str(pid_raw))
        pid = ctx.pipes.get("" if tid_raw is None else str(tid_raw))
        nid = ctx.names.get("" if name_raw is None else str(name_raw))

        args = obj.get("args")
        if not isinstance(args, dict):
            args = {}

        code = args.get("code")
        sid = None
        if isinstance(code, str) and code:
            sid = ctx.stacks.get(code)
            if sid not in ctx.stack_meta:
                lines = [x for x in code.split("\n") if x.strip()]
                inner = split_loc(lines[0]) if lines else (None, None)
                outer = split_loc(lines[-1]) if lines else (None, None)
                ctx.stack_meta[sid] = (inner[0], inner[1], outer[0], outer[1])
            bump2(ctx.stack_stats, sid, 1, dur or 0.0)

        detail = args.get("detail")
        did = ctx.details.get(detail) if isinstance(detail, str) and detail else None

        pc = args.get("pc_addr")
        pcid = None
        if isinstance(pc, str) and pc:
            pc = pc.lower()
            pcid = ctx.pcs.get(pc)
            bump2(ctx.pc_stats, pcid, 1, dur or 0.0)

        if ph == "M" and name_raw == "process_sort_index":
            si = args.get("sort_index")
            if isinstance(si, (int, float)):
                ctx.sort_index[cid] = int(si)

        ctx.ph_counts[ph] += 1

        st = ctx.core_stats.get(cid)
        if st is None:
            st = [0, 0, 0.0, None, None]
            ctx.core_stats[cid] = st
        st[0] += 1
        if ph == "X":
            st[1] += 1
        if dur is not None:
            st[2] += dur
        if ts is not None:
            if st[3] is None or ts < st[3]:
                st[3] = ts
            if st[4] is None or ts > st[4]:
                st[4] = ts
            if ctx.ts_min is None or ts < ctx.ts_min:
                ctx.ts_min = ts
            if ctx.ts_max is None or ts > ctx.ts_max:
                ctx.ts_max = ts

        bump2(ctx.pipe_stats, pid, 1, dur or 0.0)
        nst = ctx.name_stats.get(nid)
        if nst is None:
            nst = [0, 0, 0.0]
            ctx.name_stats[nid] = nst
        nst[0] += 1
        if ph == "X":
            nst[1] += 1
        nst[2] += dur or 0.0

        if ts is not None:
            b = int(ts // bucket_us)
            h = ctx.hist[(b, pid)]
            h[0] += 1
            if dur is not None:
                h[1] += dur

        if ph in ("B", "E"):
            group = obj.get("id")
            if group is not None:
                key = (cid, str(group))
                if ph == "B":
                    lst = ctx.open_spans.get(key)
                    if lst is None:
                        ctx.open_spans[key] = [(nid, pid, ts)]
                    else:
                        lst.append((nid, pid, ts))
                else:
                    lst = ctx.open_spans.get(key)
                    if lst:
                        b_nid, b_pid, b_ts = lst.pop()
                        if ts is not None and b_ts is not None:
                            ctx.spans.append((cid, str(group), b_nid, b_pid,
                                              b_ts, ts - b_ts))

        if dur is not None and top_n > 0:
            item = (dur, eid, ts, ph, nid, cid, pid, pcid, sid)
            if len(ctx.top_events) < top_n:
                heapq.heappush(ctx.top_events, item)
            elif item[0] > ctx.top_events[0][0]:
                heapq.heappushpop(ctx.top_events, item)

        ev_rows.append((eid, ts, dur, ph, cid, pid, nid, sid, did, pcid))
        eid += 1
        if len(ev_rows) >= EVENT_BATCH:
            cur.executemany(
                "INSERT INTO events(id,ts,dur,ph,core_id,pipe_id,name_id,"
                "code_id,detail_id,pc_id) VALUES (?,?,?,?,?,?,?,?,?,?)",
                ev_rows,
            )
            ev_rows.clear()

    if ev_rows:
        cur.executemany(
            "INSERT INTO events(id,ts,dur,ph,core_id,pipe_id,name_id,"
            "code_id,detail_id,pc_id) VALUES (?,?,?,?,?,?,?,?,?,?)",
            ev_rows,
        )
    db.commit()
    eprint(f"[perfp] trace: {ctx.event_count} events in {time.time() - t0:.1f}s")


# --------------------------------------------------------------------------
# record 30: instructions
# --------------------------------------------------------------------------

def load_json_record(f, rec):
    f.seek(rec.payload)
    raw = f.read(rec.length)
    return json.loads(raw.rstrip(b"\x00").decode("utf-8", "replace"))


def ingest_instructions(f, rec, ctx, db):
    j = load_json_record(f, rec)
    cores = j.get("Cores") or []
    core_ids = [ctx.cores.get(str(c)) for c in cores]
    cur = db.cursor()

    instr_rows = []
    ic_rows = []
    for it in j.get("Instructions") or []:
        if not isinstance(it, dict):
            continue
        addr = str(it.get("Address") or "").lower()
        src = it.get("AscendC Inner Code") or ""
        lid = ctx.locations.get(src) if src else None
        source = it.get("Source") or ""
        mnemonic = source.split(" ", 1)[0].strip() if source else ""
        pipe = it.get("Pipe") or ""

        instr_rows.append((addr, mnemonic, pipe, src, lid))

        arrs = {
            "calls": it.get("Instructions Executed") or [],
            "cycles": it.get("Cycles") or [],
            "gpr": it.get("GPR Count") or [],
            "pb": it.get("Process Bytes") or [],
            "ubr": it.get("UB Read Conflict") or [],
            "ubw": it.get("UB Write Conflict") or [],
            "util": it.get("Vector Utilization Percentage") or [],
        }

        for k, cid in enumerate(core_ids):
            def val(name, default):
                a = arrs[name]
                return a[k] if k < len(a) else default

            ic_rows.append((
                addr, cid,
                val("calls", 0),
                val("cycles", 0),
                val("gpr", 0),
                val("pb", -1),
                val("ubr", -1),
                val("ubw", -1),
                val("util", None),
            ))

    cur.executemany(
        "INSERT OR REPLACE INTO instructions(addr,mnemonic,pipe,src,location_id)"
        " VALUES (?,?,?,?,?)", instr_rows)
    cur.executemany(
        "INSERT OR REPLACE INTO instruction_core(addr,core_id,calls,cycles,gpr,"
        "process_bytes,ub_read_conflict,ub_write_conflict,vector_util)"
        " VALUES (?,?,?,?,?,?,?,?,?)", ic_rows)
    db.commit()
    eprint(f"[perfp] instructions: {len(instr_rows)} instructions x "
           f"{len(core_ids)} cores")


# --------------------------------------------------------------------------
# record 1: embedded sources
# --------------------------------------------------------------------------

def extract_sources(f, recs, out_dir, ctx):
    src_dir = os.path.join(out_dir, "src")
    os.makedirs(src_dir, exist_ok=True)
    manifest = []
    used = {}

    for rec in recs:
        f.seek(rec.payload)
        raw = f.read(rec.length)

        nul = raw.find(b"\x00")
        if nul < 0:
            original = raw.decode("utf-8", "replace").strip()
            content_b = b""
        else:
            original = raw[:nul].decode("utf-8", "replace")
            i = nul
            while i < len(raw) and raw[i] == 0:
                i += 1
            content_b = raw[i:].rstrip(b"\x00")

        rel = safe_relpath(original)
        if rel in used and used[rel] != original:
            base, ext = os.path.splitext(rel)
            rel = f"{base}__{rec.index}{ext}"
        used[rel] = original

        dest = os.path.join(src_dir, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "wb") as g:
            g.write(content_b)

        text = content_b.decode("utf-8", "replace")
        n_lines = text.count("\n") + (1 if text else 0)
        ctx.source_local[original] = os.path.relpath(dest, out_dir)
        manifest.append((original, os.path.relpath(dest, out_dir),
                         len(content_b), n_lines))

    with open(os.path.join(src_dir, "MANIFEST.csv"), "w", newline="",
              encoding="utf-8") as g:
        w = csv.writer(g)
        w.writerow(["original_path", "local_path", "size_bytes", "lines"])
        w.writerows(manifest)

    eprint(f"[perfp] sources: {len(manifest)} files, "
           f"{human(sum(m[2] for m in manifest))}")


# --------------------------------------------------------------------------
# record 29: per-file line statistics
# --------------------------------------------------------------------------

def ingest_files(f, rec, ctx, db):
    j = load_json_record(f, rec)
    cur = db.cursor()

    fid = 0
    for fi in j.get("Files") or []:
        if not isinstance(fi, dict):
            continue
        path = fi.get("Source") or ""
        lines = fi.get("Lines") or []
        local = ctx.source_local.get(path)

        # source file size / line count from the extracted copy when available
        size = None
        n_lines = len(lines)
        if local:
            full = os.path.join(os.path.dirname(db_path_global), local) \
                if db_path_global else None
            if full and os.path.isfile(full):
                size = os.path.getsize(full)

        cur.execute(
            "INSERT OR REPLACE INTO files(id,path,local_path,size,n_lines)"
            " VALUES (?,?,?,?,?)", (fid, path, local, size, n_lines))

        rows = []
        for e in lines:
            if not isinstance(e, dict):
                continue
            cyc = [x for x in (e.get("Cycles") or [])
                   if isinstance(x, (int, float))]
            gpr = [x for x in (e.get("GPR Count") or [])
                   if isinstance(x, (int, float))]
            inst = [x for x in (e.get("Instructions Executed") or [])
                    if isinstance(x, (int, float))]
            pb = [x for x in (e.get("Process Bytes") or [])
                  if isinstance(x, (int, float))]
            addr_ranges = json.dumps(e.get("Address Range") or [],
                                     separators=(",", ":"))
            rows.append((
                fid,
                e.get("Line"),
                addr_ranges,
                sum(cyc),
                max(gpr) if gpr else 0,
                sum(inst),
                sum(pb),
            ))
        cur.executemany(
            "INSERT OR REPLACE INTO file_lines(file_id,line,addr_ranges,"
            "cycles,gpr,instructions_executed,process_bytes)"
            " VALUES (?,?,?,?,?,?,?)", rows)
        fid += 1

    db.commit()
    eprint(f"[perfp] files: {fid} files")


