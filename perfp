def prepare_out(path, force):
    path = os.path.abspath(path)
    if os.path.exists(path) and os.listdir(path):
        if not force:
            raise PerfpError(
                f"output directory {path} is not empty (use --force to replace)")
        if path in ("/", os.path.expanduser("~")):
            raise PerfpError("refusing to remove a protected directory")
        shutil.rmtree(path)
    os.makedirs(path, exist_ok=True)
    return path


def write_raw_trace(f, rec, out_dir, plain=False):
    """Write the trace payload, stripping the container's trailing NUL padding.

    The payload is a complete JSON document followed by a few NUL bytes.  We
    keep the JSON text byte-for-byte so the original timeline is lossless, but
    drop the padding so the result is directly consumable by jq/json.load.
    """
    raw_dir = os.path.join(out_dir, "raw")
    os.makedirs(raw_dir, exist_ok=True)

    # discover trailing NUL padding from the last block only
    probe = min(64, rec.length)
    f.seek(rec.payload + rec.length - probe)
    tail = f.read(probe)
    stripped = len(tail) - len(tail.rstrip(b"\x00"))
    body_len = rec.length - stripped

    dest = os.path.join(raw_dir, "trace.json" if plain else "trace.json.gz")
    opener = open if plain else lambda p, mode: gzip.open(
        p, mode, compresslevel=6)
    with opener(dest, "wb") as g:
        f.seek(rec.payload)
        left = body_len
        while left:
            chunk = f.read(min(8 << 20, left))
            if not chunk:
                break
            g.write(chunk)
            left -= len(chunk)
    eprint(f"[perfp] raw timeline: {human(os.path.getsize(dest))}")


def write_raw_records(f, recs, out_dir):
    raw_dir = os.path.join(out_dir, "raw", "records")
    os.makedirs(raw_dir, exist_ok=True)
    for rec in recs:
        if rec.type in (TYPE_FILES, TYPE_INSTRUCTIONS):
            f.seek(rec.payload)
            raw = f.read(rec.length).rstrip(b"\x00")
            try:
                obj = json.loads(raw.decode("utf-8", "replace"))
            except Exception:
                continue
            name = "files.json" if rec.type == TYPE_FILES else "instructions.json"
            with open(os.path.join(raw_dir, name), "w", encoding="utf-8") as g:
                json.dump(obj, g, ensure_ascii=False, separators=(",", ":"))


def write_meta_files(out_dir, meta):
    with open(os.path.join(out_dir, "schema.sql"), "w", encoding="utf-8") as f:
        f.write(DDL.strip() + "\n")

    queries = """\
-- perfp example queries
-- open with: sqlite3 profile.sqlite

-- 1. Pipe balance (accumulated instruction latency; overlapping pipes)
SELECT name, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM pipes ORDER BY dur_sum_us DESC;

-- 2. Per-core balance
SELECT name, n_events, n_x, ROUND(dur_sum_us,2) AS dur_us
FROM cores ORDER BY dur_sum_us DESC;

-- 3. Top instruction mnemonics by accumulated trace latency
SELECT mnemonic, SUM(calls) AS calls, SUM(cycles) AS cycles,
       SUM(trace_dur_us) AS trace_dur_us
FROM v_instruction GROUP BY mnemonic
ORDER BY trace_dur_us DESC LIMIT 20;

-- 4. Top executed source locations (innermost frame)
SELECT file, line, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM v_exec_location ORDER BY dur_sum_us DESC LIMIT 20;

-- 5. Top kernel call sites (outermost frame)
SELECT file, line, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM v_kernel_location ORDER BY dur_sum_us DESC LIMIT 20;

-- 6. Top instructions, including their source mapping
SELECT addr, mnemonic, pipe, src, calls, cycles, trace_n,
       ROUND(trace_dur_us,2) AS trace_dur_us
FROM v_instruction ORDER BY trace_dur_us DESC LIMIT 20;

-- 7. One core, one time window
SELECT e.ts, e.dur, e.ph,
       (SELECT name FROM names WHERE id = e.name_id) AS name,
       (SELECT code FROM code_stacks WHERE id = e.code_id) AS code
FROM events e
WHERE e.core_id = (SELECT id FROM cores WHERE name='core0.veccore0')
  AND e.ts BETWEEN 10.0 AND 11.0
ORDER BY e.ts;

-- 8. Cross-core synchronization spans
SELECT n.name, COUNT(*) AS count, ROUND(SUM(s.dur),2) AS dur_sum_us,
       ROUND(MAX(s.dur),4) AS dur_max_us
FROM spans s JOIN names n ON n.id = s.name_id
GROUP BY s.name_id ORDER BY SUM(s.dur) DESC;

-- 9. Timeline load per pipe (bucket size is the build --bucket-us)
SELECT h.bucket_start_us, COALESCE(p.name,'') AS pipe,
       h.count, ROUND(h.dur_sum_us,3) AS dur_us
FROM timeline_hist h LEFT JOIN pipes p ON p.id = h.pipe_id
ORDER BY h.bucket_start_us, h.pipe_id;

-- 10. Which source line does the hottest instruction belong to?
SELECT addr, mnemonic, pipe, src, ROUND(trace_dur_us,2) AS trace_dur_us
FROM v_instruction ORDER BY trace_dur_us DESC LIMIT 10;
"""
    with open(os.path.join(out_dir, "queries.sql"), "w", encoding="utf-8") as f:
        f.write(queries)


README = """\
# perfp output bundle

This directory was produced by `perfp`, a zero-dependency preprocessor for
Ascend simulator `visualize_data.bin` dumps.  It is designed so that an AI
agent can answer performance questions without ever loading the 300 MB binary.

## Read me first

1. `summary.md`  -- compact digest: trace shape, pipe/core balance, top
   mnemonics, top source locations, sync spans, caveats.
2. `profile.sqlite` -- the full, queryable dataset.  Prefer SQL over CSV.
3. `csv/` -- exported tables for grep/awk.  `events.csv.gz` is the full event
   stream (dictionary encoded: `code_id` -> `csv/code_stacks.csv`).
4. `raw/trace.json.gz` -- the original timeline, losslessly preserved.
   Only decompress it if you need to replay the exact event stream.
5. `src/` -- source files embedded in the dump (including `kernel.asc`).
   `src/MANIFEST.csv` maps original absolute path -> local file.

## SQLite schema (main tables)

| table | rows | meaning |
|---|---|---|
| `meta` | key/value | build info |
| `cores` | one per core | name, event count, accumulated `dur` |
| `pipes` | one per pipe | name, event count, accumulated `dur` |
| `names` | one per event name | mostly instruction mnemonics |
| `code_stacks` | ~1k | full multi-line `args.code` stack, inner/outer location, aggregated |
| `locations` | few k | single `file:line` (instruction source mapping) |
| `details` | ~80k | `args.detail` strings |
| `pcs` | ~2k | `args.pc_addr`, aggregated |
| `events` | ~600k | ts, dur, ph, core/pipe/name/code/detail/pc ids |
| `spans` | ~10k | matched B/E pairs (sync flags) |
| `instructions` | ~2k | static instruction table from record 30 |
| `instruction_core` | ~90k | per instruction x per core counters |
| `files` / `file_lines` | ~30 / ~600 | record 29 per-line statistics |
| `timeline_hist` | small | histogram of events over time |

Convenience views:

- `v_instruction`   -- instructions joined with per-core counters and trace latency
- `v_code_line`     -- per `file:line` instruction accounting
- `v_code_line_core`-- same, per core
- `v_exec_location` -- trace latency grouped by innermost stack frame
- `v_kernel_location` -- trace latency grouped by outermost (user kernel) frame

All `*_id` columns are small integers.  Join to `cores`, `pipes`, `names`,
`code_stacks`, `details`, `pcs` for text.

## Metric semantics (important)

- `events.dur` is the per-instruction latency reported by the simulator.  Sums
  over pipes/cores **overlap**, so they can exceed wall time.  Use it for
  *relative* hotspots, not elapsed time.
- `instruction_core.cycles` is simulator-internal accounting.  It is **not**
  core clock cycles and must not be converted to microseconds.  `perfp` emits a
  warning in `summary.md` when the implied frequency is implausible.
- `spans.dur` is a real `E.ts - B.ts` duration for matched sync flags.

## Reproduce

```bash
./perfp <case-or-OPPROF-dir-or-bin> -o perfp_out
./perfp info <bin>            # show the container record table
./perfp <input> -o out --force --no-events-csv --raw-plain
./perfp <input> -o out --events-csv-plain   # events.csv instead of .gz
```
"""


def build(args):
    global db_path_global, out_global, QUIET

    QUIET = bool(getattr(args, "quiet", False))
    t_start = time.time()
    bin_path = find_bin(args.input)
    bin_size = os.path.getsize(bin_path)
    out_dir = prepare_out(args.out, args.force)
    out_global = out_dir

    db_path = os.path.join(out_dir, "profile.sqlite")
    db_path_global = db_path
    db = sqlite3.connect(db_path)
    db.executescript(DDL)

    case_json, sim_log = find_case_files(bin_path)
    meta = {
        "perfp_version": VERSION,
        "schema_version": SCHEMA_VERSION,
        "built_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "input": bin_path,
        "bin_size": bin_size,
        "bucket_us": args.bucket_us,
        "top_n": args.top,
        "case": case_json,
    }

    ctx = Ctx()
    with open(bin_path, "rb") as f:
        records = list(iter_records(f, bin_size))
        meta["records"] = len(records)

        by_type = Counter(r.type for r in records)
        eprint(f"[perfp] {len(records)} records: "
               + ", ".join(f"type{t}={n}" for t, n in sorted(by_type.items())))

        trace_recs = [r for r in records if r.type == TYPE_TRACE]
        instr_recs = [r for r in records if r.type == TYPE_INSTRUCTIONS]
        files_recs = [r for r in records if r.type == TYPE_FILES]
        source_recs = [r for r in records if r.type == TYPE_SOURCE]

        if not trace_recs:
            raise PerfpError("no trace record (type=2) found in container")

        if not args.no_raw:
            write_raw_trace(f, trace_recs[0], out_dir, plain=args.raw_plain)
        write_raw_records(f, records, out_dir)

        # trace
        tr = trace_recs[0]
        f.seek(tr.payload)
        payload = f.read(tr.length)
        ingest_trace(payload, ctx, db, args.bucket_us, args.top)
        del payload

        # instructions
        if instr_recs:
            ingest_instructions(f, instr_recs[0], ctx, db)

        # embedded sources
        if not args.no_src and source_recs:
            extract_sources(f, source_recs, out_dir, ctx)

        # files table
        if files_recs:
            ingest_files(f, files_recs[0], ctx, db)

    finalize_db(db, ctx, args.bucket_us)

    export_csvs(db, out_dir, ctx, want_events=not args.no_events_csv,
                top_n=args.top, events_plain=args.events_csv_plain)

    # optional sim log cross-check (after export_csvs creates csv/)
    if sim_log:
        rows = parse_simlog(sim_log)
        if rows:
            write_csv(os.path.join(out_dir, "csv", "cores_simlog.csv"),
                      ["core_name", "duration_time_us", "running_time_us"], rows)
            meta["simlog"] = os.path.basename(sim_log)
            eprint(f"[perfp] sim log: {len(rows)} cores")

    # write small metadata + docs
    write_meta_files(out_dir, meta)
    with open(os.path.join(out_dir, "README.md"), "w", encoding="utf-8") as f:
        f.write(README)

    meta_rows = [(k, json.dumps(v, ensure_ascii=False)
                  if isinstance(v, (dict, list)) else ("" if v is None else str(v)))
                 for k, v in meta.items()]
    db.executemany("INSERT OR REPLACE INTO meta(key,value) VALUES (?,?)",
                   meta_rows)
    db.commit()

    build_summary(db, out_dir, ctx, meta)

    try:
        db.execute("ANALYZE")
        db.commit()
    except sqlite3.Error:
        pass

    # final stats
    db_size = os.path.getsize(db_path)
    db.close()
    total = sum(os.path.getsize(os.path.join(dp, fn))
                for dp, _dn, fns in os.walk(out_dir) for fn in fns)
    eprint(f"[perfp] done in {time.time() - t_start:.1f}s: "
           f"{human(total)} total, sqlite {human(db_size)} -> {out_dir}")
    eprint("[perfp] start with: " + os.path.join(out_dir, "summary.md"))
    return 0


