    ts REAL,
    dur REAL,
    core_id INTEGER,
    pipe_id INTEGER,
    direction TEXT,
    name_id INTEGER,
    code_id INTEGER,
    detail_id INTEGER,
    pc_id INTEGER,
    addr TEXT,
    file TEXT,
    line INTEGER,
    outer_file TEXT,
    outer_line INTEGER,
    mnemonic TEXT,
    block_bytes REAL,
    bytes_source TEXT,
    buffer_key TEXT,
    duplicate_key TEXT,
    repeat_index INTEGER,
    duplicate_count INTEGER,
    classification TEXT,
    stride_bytes REAL,
    overlap_us REAL
);

CREATE INDEX idx_events_pipe_ts ON events(pipe_id, ts);
CREATE INDEX idx_events_core_pipe_ts ON events(core_id, pipe_id, ts);
CREATE INDEX idx_spans_group ON spans(core_id, group_id);
CREATE INDEX idx_pipe_gaps_core_pipe ON pipe_gaps(core_id, pipe_id, ts);
CREATE INDEX idx_wait_gap ON wait_attribution(gap_id);
CREATE INDEX idx_dma_event ON dma_events(core_id, pipe_id, ts);

CREATE TABLE instructions(
    addr TEXT PRIMARY KEY,
    mnemonic TEXT,
    pipe TEXT,
    src TEXT,
    location_id INTEGER
);

CREATE TABLE instruction_core(
    addr TEXT,
    core_id INTEGER,
    calls INTEGER,
    cycles INTEGER,
    gpr INTEGER,
    process_bytes INTEGER,
    ub_read_conflict INTEGER,
    ub_write_conflict INTEGER,
    vector_util REAL,
    PRIMARY KEY(addr, core_id)
);

CREATE TABLE files(
    id INTEGER PRIMARY KEY,
    path TEXT NOT NULL UNIQUE,
    local_path TEXT,
    size INTEGER,
    n_lines INTEGER
);

CREATE TABLE file_lines(
    file_id INTEGER,
    line INTEGER,
    addr_ranges TEXT,
    cycles INTEGER,
    gpr INTEGER,
    instructions_executed INTEGER,
    process_bytes INTEGER,
    PRIMARY KEY(file_id, line)
);

CREATE TABLE timeline_hist(
    bucket_start_us REAL,
    pipe_id INTEGER,
    count INTEGER,
    dur_sum_us REAL
);

CREATE INDEX idx_events_core ON events(core_id);
CREATE INDEX idx_events_name ON events(name_id);
CREATE INDEX idx_events_code ON events(code_id);
CREATE INDEX idx_events_ts ON events(ts);
CREATE INDEX idx_spans_name ON spans(name_id);
CREATE INDEX idx_ic_addr ON instruction_core(addr);
CREATE INDEX idx_ic_core ON instruction_core(core_id);
CREATE INDEX idx_hist_bucket ON timeline_hist(bucket_start_us);

CREATE VIEW v_instruction AS
SELECT i.addr AS addr,
       i.mnemonic AS mnemonic,
       i.pipe AS pipe,
       i.src AS src,
       l.file AS file,
       l.line AS line,
       COALESCE((SELECT SUM(calls)  FROM instruction_core ic WHERE ic.addr=i.addr),0) AS calls,
       COALESCE((SELECT SUM(cycles) FROM instruction_core ic WHERE ic.addr=i.addr),0) AS cycles,
       COALESCE((SELECT COUNT(*)    FROM instruction_core ic WHERE ic.addr=i.addr),0) AS core_count,
       COALESCE(p.n_events,0)    AS trace_n,
       COALESCE(p.dur_sum_us,0)  AS trace_dur_us
FROM instructions i
LEFT JOIN locations l ON l.id = i.location_id
LEFT JOIN pcs p       ON p.addr = i.addr;

CREATE VIEW v_code_line AS
SELECT l.file AS file,
       l.line AS line,
       l.text AS loc,
       SUM(ic.calls)  AS calls,
       SUM(ic.cycles) AS cycles,
       COUNT(DISTINCT ic.core_id) AS core_count
FROM instructions i
JOIN instruction_core ic ON ic.addr = i.addr
JOIN locations l         ON l.id = i.location_id
GROUP BY i.location_id;

CREATE VIEW v_code_line_core AS
SELECT ic.core_id AS core_id,
       l.file AS file,
       l.line AS line,
       SUM(ic.calls)  AS calls,
       SUM(ic.cycles) AS cycles
FROM instructions i
JOIN instruction_core ic ON ic.addr = i.addr
JOIN locations l         ON l.id = i.location_id
GROUP BY ic.core_id, i.location_id;

CREATE VIEW v_exec_location AS
SELECT inner_file AS file,
       inner_line AS line,
       SUM(n_events)   AS n_events,
       SUM(dur_sum_us) AS dur_sum_us,
       COUNT(*)        AS stacks
FROM code_stacks
WHERE inner_file IS NOT NULL
GROUP BY inner_file, inner_line;

CREATE VIEW v_kernel_location AS
SELECT outer_file AS file,
       outer_line AS line,
       SUM(n_events)   AS n_events,
       SUM(dur_sum_us) AS dur_sum_us,
       COUNT(*)        AS stacks
FROM code_stacks
WHERE outer_file IS NOT NULL
GROUP BY outer_file, outer_line;

CREATE VIEW v_pipe_activity AS
SELECT c.name AS core,
       p.name AS pipe,
       s.core_id,
       s.pipe_id,
       COUNT(*) AS segments,
       ROUND(SUM(s.dur), 4) AS active_us,
       MIN(s.ts) AS first_ts,
       MAX(s.ts + s.dur) AS last_ts,
       COALESCE(g.gap_count, 0) AS gap_count,
       ROUND(COALESCE(g.gap_us, 0), 4) AS gap_us,
       ROUND(COALESCE(g.attributed_us, 0), 4) AS attributed_gap_us,
       ROUND(COALESCE(g.unattributed_us, 0), 4) AS unattributed_gap_us
FROM pipe_segments s
JOIN cores c ON c.id = s.core_id
JOIN pipes p ON p.id = s.pipe_id
LEFT JOIN (
    SELECT core_id, pipe_id, COUNT(*) AS gap_count,
           SUM(dur) AS gap_us,
           SUM(attributed_us) AS attributed_us,
           SUM(unattributed_us) AS unattributed_us
    FROM pipe_gaps
    GROUP BY core_id, pipe_id
) g ON g.core_id = s.core_id AND g.pipe_id = s.pipe_id
GROUP BY s.core_id, s.pipe_id;

CREATE VIEW v_pipe_gap AS
SELECT g.id,
       c.name AS core,
       p.name AS pipe,
       g.ts,
       g.dur,
       COALESCE(nb.name, '') AS before_name,
       COALESCE(na.name, '') AS after_name,
       cb.outer_file AS before_file,
       cb.outer_line AS before_line,
       ca.outer_file AS after_file,
       ca.outer_line AS after_line,
       g.attributed_us,
       g.unattributed_us,
       g.attributed_waits,
       g.status,
       g.peers,
       g.before_event_id,
       g.after_event_id
FROM pipe_gaps g
JOIN cores c ON c.id = g.core_id
JOIN pipes p ON p.id = g.pipe_id
LEFT JOIN events eb ON eb.id = g.before_event_id
LEFT JOIN events ea ON ea.id = g.after_event_id
LEFT JOIN names nb ON nb.id = eb.name_id
LEFT JOIN names na ON na.id = ea.name_id
LEFT JOIN code_stacks cb ON cb.id = eb.code_id
LEFT JOIN code_stacks ca ON ca.id = ea.code_id;

CREATE VIEW v_wait_attribution AS
SELECT w.id,
       c.name AS core,
       cp.name AS consumer_pipe,
       cn.name AS consumer_name,
       cs.inner_file AS consumer_inner_file,
       cs.inner_line AS consumer_inner_line,
       cs.outer_file AS consumer_outer_file,
       cs.outer_line AS consumer_outer_line,
       w.wait_ts,
       w.wait_dur,
       pp.name AS producer_pipe,
       pn.name AS producer_name,
       w.producer_event_id,
       ps.inner_file AS producer_inner_file,
       ps.inner_line AS producer_inner_line,
       ps.outer_file AS producer_outer_file,
       ps.outer_line AS producer_outer_line,
       w.producer_ts,
       w.producer_end_ts,
       w.delay_us,
       w.slack_us,
       w.status,
       w.blocks_on_dma,
       w.gap_id
FROM wait_attribution w
JOIN cores c ON c.id = w.core_id
LEFT JOIN pipes cp ON cp.id = w.consumer_pipe_id
LEFT JOIN names cn ON cn.id = w.consumer_name_id
LEFT JOIN code_stacks cs ON cs.id = w.consumer_code_id
LEFT JOIN pipes pp ON pp.id = w.producer_pipe_id
LEFT JOIN names pn ON pn.id = w.producer_name_id
LEFT JOIN code_stacks ps ON ps.id = w.producer_code_id;

CREATE VIEW v_dma_source AS
SELECT COALESCE(d.file, '(unknown)') AS file,
       d.line,
       p.name AS pipe,
       d.direction,
       COUNT(*) AS events,
       ROUND(SUM(COALESCE(d.block_bytes, 0)), 1) AS bytes_inferred,
       SUM(CASE WHEN d.block_bytes IS NULL THEN 1 ELSE 0 END)
           AS events_without_bytes,
       ROUND(SUM(COALESCE(d.overlap_us, 0)), 4) AS overlap_us,
       SUM(CASE WHEN d.classification = 'duplicate_candidate' THEN 1 ELSE 0 END)
           AS duplicate_events,
       MIN(d.block_bytes) AS min_block_bytes,
       MAX(d.block_bytes) AS max_block_bytes,
       COUNT(DISTINCT d.buffer_key) AS buffers
FROM dma_events d
JOIN pipes p ON p.id = d.pipe_id
GROUP BY d.file, d.line, d.pipe_id, d.direction;

CREATE VIEW v_dma_kernel_source AS
SELECT COALESCE(d.outer_file, '(unknown)') AS file,
       d.outer_line AS line,
       p.name AS pipe,
       d.direction,
       COUNT(*) AS events,
       ROUND(SUM(COALESCE(d.block_bytes, 0)), 1) AS bytes_inferred,
       SUM(CASE WHEN d.block_bytes IS NULL THEN 1 ELSE 0 END)
           AS events_without_bytes,
       ROUND(SUM(COALESCE(d.overlap_us, 0)), 4) AS overlap_us,
       SUM(CASE WHEN d.classification = 'duplicate_candidate' THEN 1 ELSE 0 END)
           AS duplicate_events
FROM dma_events d
JOIN pipes p ON p.id = d.pipe_id
GROUP BY d.outer_file, d.outer_line, d.pipe_id, d.direction;

CREATE VIEW v_dma_buffer AS
SELECT d.addr,
       d.buffer_key,
       p.name AS pipe,
       d.direction,
       COALESCE(d.file, '(unknown)') AS file,
       d.line,
       d.outer_file,
       d.outer_line,
       COUNT(*) AS events,
       ROUND(SUM(COALESCE(d.block_bytes, 0)), 1) AS bytes_inferred,
       MIN(d.block_bytes) AS min_block_bytes,
       MAX(d.block_bytes) AS max_block_bytes,
       MIN(d.stride_bytes) AS min_stride_bytes,
       MAX(d.stride_bytes) AS max_stride_bytes,
       SUM(CASE WHEN d.classification = 'duplicate_candidate' THEN 1 ELSE 0 END)
           AS duplicate_events
FROM dma_events d
JOIN pipes p ON p.id = d.pipe_id
GROUP BY d.addr, d.duplicate_key, d.pipe_id, d.direction;

CREATE VIEW v_dma_instruction AS
SELECT d.addr,
       d.mnemonic,
       p.name AS pipe,
       d.direction,
       COALESCE(d.file, '(unknown)') AS file,
       d.line,
       d.outer_file,
       d.outer_line,
       COUNT(*) AS events,
       ROUND(SUM(COALESCE(d.block_bytes, 0)), 1) AS bytes_inferred,
       MIN(d.block_bytes) AS min_block_bytes,
       MAX(d.block_bytes) AS max_block_bytes,
       ROUND(SUM(COALESCE(d.overlap_us, 0)), 4) AS overlap_us,
