def _merge_activity(rows):
    """Merge (ts, end, event_id) rows into disjoint segments.

    Rows must be sorted by ts.  Returns (start, end, first_event_id,
    last_event_id, n_events) tuples.  ``last_event_id`` is the event that
    reaches farthest to the right, not simply the last row seen.
    """
    merged = []
    for ts, end, eid in rows:
        if end < ts:
            continue
        if merged and ts <= merged[-1][1] + 1e-9:
            cur = merged[-1]
            if end >= cur[1]:
                cur = (cur[0], end, cur[2], eid, cur[4] + 1)
                merged[-1] = cur
            else:
                merged[-1] = (cur[0], cur[1], cur[2], cur[3], cur[4] + 1)
        else:
            merged.append((ts, end, eid, eid, 1))
    return merged


def _overlap_merged(merged, a, b):
    """Length of the intersection of [a,b] with disjoint merged segments."""
    if not merged or b <= a:
        return 0.0
    starts = [m[0] for m in merged]
    i = max(0, bisect.bisect_right(starts, a) - 1)
    total = 0.0
    n = len(merged)
    while i < n and merged[i][0] < b:
        s, e = merged[i][0], merged[i][1]
        lo, hi = max(a, s), min(b, e)
        if hi > lo:
            total += hi - lo
        i += 1
    return total


def _union_overlaps(intervals, a, b):
    """Union length of clipped [start,end] intervals inside [a,b]."""
    clipped = []
    for s, e in intervals:
        lo, hi = max(a, s), min(b, e)
        if hi > lo:
            clipped.append((lo, hi))
    if not clipped:
        return 0.0
    clipped.sort()
    total = clipped[0][1] - clipped[0][0]
    last = clipped[0][1]
    for s, e in clipped[1:]:
        if s > last:
            total += e - s
            last = e
        elif e > last:
            total += e - last
            last = e
    return total


def _load_pipe_segments(db):
    """Load merged X-event activity per (core_id, pipe_id)."""
    cur = db.cursor()
    pipe_names = dict(cur.execute("SELECT id,name FROM pipes"))
    out = defaultdict(list)
    buf = []
    key = None
    sql = ("SELECT core_id,pipe_id,ts,ts+dur,id FROM events "
           "WHERE ph='X' AND ts IS NOT NULL AND dur IS NOT NULL AND dur>=0 "
           "ORDER BY core_id,pipe_id,ts,id")
    for core_id, pipe_id, ts, end, eid in cur.execute(sql):
        if pipe_names.get(pipe_id) in MARKER_PIPES:
            continue
        k = (core_id, pipe_id)
        if key is not None and k != key:
            out[key] = _merge_activity(buf)
            buf = []
        key = k
        buf.append((ts, end, eid))
    if key is not None:
        out[key] = _merge_activity(buf)
    return out


def _insert_pipe_segments(db, segments):
    cur = db.cursor()
    rows = []
    for (core_id, pipe_id), merged in sorted(segments.items()):
        for start, end, first_id, last_id, n in merged:
            rows.append((core_id, pipe_id, start, end - start, n,
                         first_id, last_id))
    cur.executemany(
        "INSERT INTO pipe_segments(core_id,pipe_id,ts,dur,n_events,"
        "first_event_id,last_event_id) VALUES (?,?,?,?,?,?,?)", rows)
    db.commit()
    return len(rows)


def _is_producer_name(name):
    u = (name or "").upper()
    return any(tok in u for tok in PRODUCER_NAME_HINTS)


def _is_wait_name(name):
    u = (name or "").upper()
    return any(tok in u for tok in WAIT_NAME_HINTS) and not _is_producer_name(u)


def _preceding_work(work_list, flag_ts, lookback_us=2.0):
    """Latest X event on a pipe that finished at/near the producer flag."""
    if not work_list:
        return None
    starts = [w[0] for w in work_list]
    i = bisect.bisect_right(starts, flag_ts + WAIT_MATCH_TOL_US) - 1
    best = None
    j = i
    floor = flag_ts - max(lookback_us, 60.0)
    while j >= 0 and j > i - 128 and work_list[j][0] >= floor:
        w = work_list[j]
        if w[1] >= flag_ts - lookback_us and (best is None or w[1] > best[1]):
            best = w
        j -= 1
    return best


def analyze_wait_attribution(db):
    """Pair WAIT_FLAG-like spans with SET_FLAG-like spans in the same group.

    The simulator emits B/E pairs whose ``group_id`` is shared by the
    producer and the consumer of a flag.  A SET_FLAG span is only a tiny
    marker *after* the real work, so when possible we replace it with the
    latest X event on the same core+pipe.  That is the instruction (often an
    MTE2/MTE3 DMA transfer) the consumer actually waited for.
    """
    cur = db.cursor()
    waits = []
    producers = defaultdict(list)
    sql = ("SELECT s.id,s.core_id,s.group_id,s.name_id,n.name,s.pipe_id,"
           "s.ts,s.dur,s.code_id FROM spans s JOIN names n ON n.id=s.name_id "
           "WHERE s.ts IS NOT NULL AND s.dur IS NOT NULL")
    for sid, core_id, group, nid, name, pid, ts, dur, code_id in cur.execute(sql):
        item = (sid, nid, pid, ts, dur, code_id, name)
        if _is_wait_name(name):
            waits.append((core_id, group, *item))
        elif _is_producer_name(name):
            producers[(core_id, group)].append(item)

    producer_pipe_ids = {p[2] for rows in producers.values() for p in rows}
    work_by_pipe = defaultdict(list)
    if producer_pipe_ids:
        marks = ",".join("?" for _ in producer_pipe_ids)
        for core_id, pipe_id, ts, dur, eid, code_id in cur.execute(
                "SELECT core_id,pipe_id,ts,dur,id,code_id FROM events "
                "WHERE ph='X' AND dur IS NOT NULL AND ts IS NOT NULL "
                "AND pipe_id IN (" + marks + ") ORDER BY core_id,pipe_id,ts",
                tuple(producer_pipe_ids)):
            work_by_pipe[(core_id, pipe_id)].append(
                (ts, ts + (dur or 0.0), eid, code_id))

    pipe_names = dict(cur.execute("SELECT id,name FROM pipes"))
    rows = []
    stats = Counter()
    for core_id, group, sid, nid, pid, ts, dur, code_id, name in waits:
        cands = producers.get((core_id, group)) or []
        best = None
        status = "unknown_no_producer"
        if cands:
            before = [p for p in cands if p[3] + p[4] <= ts + dur + WAIT_MATCH_TOL_US]
            if before:
                best = max(before, key=lambda p: (p[3] + p[4], p[3]))
            else:
                best = min(cands, key=lambda p: (p[3], p[4]))
        delay = None
        slack = None
        prod_span = prod_event = prod_pipe = prod_name = prod_code = None
        prod_ts = prod_end = None
        if best is not None:
            prod_span, prod_nid, prod_pipe, flag_ts, flag_dur, flag_code, _ = best
            prod_name = prod_nid
            prod_code = flag_code
            prod_ts = flag_ts
            prod_end = flag_ts + (flag_dur or 0.0)
            work = _preceding_work(work_by_pipe.get((core_id, prod_pipe), []),
                                   flag_ts)
            if work is not None:
                prod_event = work[2]
                prod_ts, prod_end, _, prod_code = work
                if prod_code is None:
                    prod_code = flag_code
            wait_end = ts + (dur or 0.0)
            if prod_end < ts - WAIT_MATCH_TOL_US:
                status = "flag_already_set"
                delay = 0.0
                slack = ts - prod_end
            elif prod_end <= wait_end + WAIT_MATCH_TOL_US:
                status = "blocked_on_producer"
                delay = max(0.0, min(wait_end, prod_end) - ts)
                slack = wait_end - prod_end
            else:
                status = "producer_after_wait"
                delay = None
                slack = wait_end - prod_end
        stats[status] += 1
        prod_pipe_name = pipe_names.get(prod_pipe) if prod_pipe is not None else None
        blocks = 1 if prod_pipe_name in DMA_PIPES else 0
        rows.append((sid, core_id, pid, nid, code_id, ts, dur,
                     prod_span, prod_event, prod_pipe, prod_name, prod_code,
                     prod_ts, prod_end, delay, slack, status, blocks))

    cur.executemany(
        "INSERT INTO wait_attribution(span_id,core_id,consumer_pipe_id,"
        "consumer_name_id,consumer_code_id,wait_ts,wait_dur,producer_span_id,"
        "producer_event_id,producer_pipe_id,producer_name_id,producer_code_id,"
        "producer_ts,producer_end_ts,delay_us,slack_us,status,blocks_on_dma)"
        " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", rows)
    db.commit()
    return rows

def analyze_pipe_gaps(db, ctx, gap_us, top_peers=3):
    """Find idle gaps per core+pipe and attribute them to waiting consumers."""
    cur = db.cursor()
    segments = defaultdict(list)
    for core_id, pipe_id, ts, dur, first_id, last_id in cur.execute(
            "SELECT core_id,pipe_id,ts,dur,first_event_id,last_event_id "
            "FROM pipe_segments ORDER BY core_id,pipe_id,ts"):
        segments[(core_id, pipe_id)].append((ts, ts + dur, first_id, last_id))

    pipe_names = dict(cur.execute("SELECT id,name FROM pipes"))
    core_bounds = {}
    for core_id, lo, hi in cur.execute(
            "SELECT core_id,MIN(ts),MAX(ts+dur) FROM events "
            "WHERE ph='X' AND ts IS NOT NULL AND dur IS NOT NULL "
            "GROUP BY core_id"):
        core_bounds[core_id] = (lo, hi)

    # All activity per core, used to report which other pipes ran during a gap.
    by_core = defaultdict(lambda: defaultdict(list))
    for (core_id, pipe_id), segs in segments.items():
        by_core[core_id][pipe_id] = segs

    waits_by_pipe = defaultdict(list)
    for wid, core_id, prod_pipe, ts, dur in cur.execute(
            "SELECT id,core_id,producer_pipe_id,wait_ts,wait_dur "
            "FROM wait_attribution WHERE producer_pipe_id IS NOT NULL "
            "AND COALESCE(delay_us,0) > 0"):
        waits_by_pipe[(core_id, prod_pipe)].append(
            (ts, ts + (dur or 0.0), wid))

    rows = []
    wait_gap_updates = []
    for (core_id, pipe_id), segs in sorted(segments.items()):
        lo, hi = core_bounds.get(core_id, (None, None))
        if lo is None:
            continue
        # Only internal gaps between two activity segments.  Leading idle
        # before the first transfer and trailing idle after the last one are
        # not pipeline stalls, and reporting them as such is misleading.
        gaps = []
        for a, b in zip(segs, segs[1:]):
            if b[0] > a[1]:
                gaps.append((a[1], b[0], a[3], b[2]))

        for start, end, before_id, after_id in gaps:
            dur = end - start
            if dur + 1e-9 < gap_us:
                continue
            peer = []
            for other_pid, other_segs in by_core[core_id].items():
                if other_pid == pipe_id:
                    continue
                ov = _overlap_merged(other_segs, start, end)
                if ov > 0:
                    peer.append((ov, pipe_names.get(other_pid, "")))
            peer.sort(reverse=True)
            peers = "; ".join(f"{name}:{ov:.4f}" for ov, name in peer[:top_peers])

            related = waits_by_pipe.get((core_id, pipe_id), [])
            intervals = []
            for w in related:
                lo2, hi2 = max(start, w[0]), min(end, w[1])
                if hi2 > lo2:
                    intervals.append((lo2, hi2))
                    wait_gap_updates.append(w[2])
            attributed = _union_overlaps(intervals, start, end)
            status = "attributed" if attributed > 0 else "unknown_unattributed"
            rows.append((core_id, pipe_id, start, dur, before_id, after_id,
                         start, end, attributed, max(0.0, dur - attributed),
                         len(intervals), status, peers))

    cur.executemany(
        "INSERT INTO pipe_gaps(core_id,pipe_id,ts,dur,before_event_id,"
        "after_event_id,prev_end_ts,next_start_ts,attributed_us,"
        "unattributed_us,attributed_waits,status,peers)"
        " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)", rows)
    db.commit()

    # Attach each wait to the gap it overlaps (gaps of one pipe are disjoint).
    if wait_gap_updates:
        cur.executemany(
            "UPDATE wait_attribution SET gap_id=("
            "SELECT g.id FROM pipe_gaps g WHERE g.core_id=wait_attribution.core_id "
            "AND g.pipe_id=wait_attribution.producer_pipe_id "
            "AND wait_attribution.wait_ts < g.ts+g.dur "
            "AND wait_attribution.wait_ts+wait_attribution.wait_dur > g.ts "
            "LIMIT 1) WHERE id=?", [(wid,) for wid in wait_gap_updates])
        db.commit()
    return len(rows)


_BYTES_RE = re.compile(
    r"(?:^|[,;\s])(?:BYTES?|SIZE|LEN|LENGTH|NBYTES|BLOCK_BYTES)\s*[:=]\s*(\d+)",
    re.I)
_SRC_DST_RE = re.compile(r"Src\s*:\s*([A-Za-z0-9_]+)\s*,\s*Dst\s*:\s*([A-Za-z0-9_]+)",
                         re.I)
_ADDR_RE = re.compile(
    r"\b(XN|XD|XM)\s*:\s*X\d+\s*=\s*(0x[0-9a-fA-F]+)", re.I)


def _parse_detail_bytes(detail):
    m = _BYTES_RE.search(detail or "")
    return float(m.group(1)) if m else None


def _parse_direction(detail, pipe):
    m = _SRC_DST_RE.search(detail or "")
    if m:
        return f"{m.group(1).upper()}->{m.group(2).upper()}"
    return DMA_DIRECTIONS.get(pipe, "UNKNOWN")


def _buffer_key(detail):
    s = re.sub(r"0x[0-9a-fA-F]+", "<hex>", detail or "")
    s = re.sub(r"\bid\s*:\s*\d+", "id:<n>", s)
    s = re.sub(r"\s+", "", s)
    return s or "<empty>"


def _parse_addr_value(detail):
    found = {}
    for m in _ADDR_RE.finditer(detail or ""):
        found.setdefault(m.group(1).upper(), int(m.group(2), 16))
    for key in ("XN", "XD", "XM"):
        if key in found:
            return found[key]
    return None


def analyze_dma(db):
    """Estimate DMA bytes per event from static Process Bytes and detail text."""
    cur = db.cursor()
    pipe_ids = {}
    for pid, name in cur.execute("SELECT id,name FROM pipes"):
        if name in DMA_PIPES:
            pipe_ids[pid] = name
    if not pipe_ids:
        return 0

    # Non-DMA activity, merged per core, for overlap accounting.
    non_dma = defaultdict(list)
    pipe_names = dict(cur.execute("SELECT id,name FROM pipes"))
    for core_id, pipe_id, ts, end in cur.execute(
            "SELECT core_id,pipe_id,ts,ts+dur FROM events "
            "WHERE ph='X' AND ts IS NOT NULL AND dur IS NOT NULL AND dur>=0"):
        if pipe_id not in pipe_ids and pipe_names.get(pipe_id) not in MARKER_PIPES:
            non_dma[core_id].append((ts, end, 0))
    merged_non_dma = {cid: _merge_activity(sorted(rows))
                      for cid, rows in non_dma.items()}

    marks = ",".join("?" for _ in pipe_ids)
    sql = (
        "SELECT e.id,e.ts,e.dur,e.core_id,e.pipe_id,p.name,"
        "e.name_id,e.code_id,e.detail_id,e.pc_id,COALESCE(pc.addr,''),"
        "COALESCE(i.mnemonic,''),COALESCE(ic.calls,0),"
        "COALESCE(ic.process_bytes,-1),COALESCE(cs.inner_file,''),"
        "cs.inner_line,COALESCE(cs.outer_file,''),cs.outer_line,"
        "COALESCE(dt.detail,'') "
        "FROM events e JOIN pipes p ON p.id=e.pipe_id "
        "LEFT JOIN pcs pc ON pc.id=e.pc_id "
        "LEFT JOIN instructions i ON i.addr=pc.addr "
        "LEFT JOIN instruction_core ic ON ic.addr=pc.addr "
        "AND ic.core_id=e.core_id "
        "LEFT JOIN code_stacks cs ON cs.id=e.code_id "
        "LEFT JOIN details dt ON dt.id=e.detail_id "
        "WHERE e.ph='X' AND p.name IN (" + marks + ") "
        "ORDER BY e.ts,e.id")
    rows = list(cur.execute(sql, tuple(pipe_ids.values())))
    if not rows:
        return 0

    parsed = []
    dup_count = Counter()
    repeat_index = Counter()
    prev_addr = {}
    for r in rows:
        (eid, ts, dur, core_id, pipe_id, pipe, nid, code_id, did, pcid,
         addr, mnemonic, calls, proc_bytes, inner_file, inner_line,
         outer_file, outer_line, detail) = r
        explicit = _parse_detail_bytes(detail)
        block = explicit
        source = "detail"
        if block is None:
            if calls and calls > 0 and proc_bytes is not None and proc_bytes >= 0:
                block = float(proc_bytes) / float(calls)
                source = "instruction_process_bytes"
            else:
                source = "unknown"
        bkey = _buffer_key(detail)
        dup_key = (addr, re.sub(r"\bid\s*:\s*\d+", "id:<n>", detail or ""))
        dup_count[dup_key] += 1
        rk = (addr, bkey)
        repeat_index[rk] += 1
        val = _parse_addr_value(detail)
        stride = None
        if val is not None and addr in prev_addr:
            stride = val - prev_addr[addr]
        if val is not None:
            prev_addr[addr] = val
        overlap = _overlap_merged(merged_non_dma.get(core_id, []), ts, ts + (dur or 0.0))
        parsed.append({
            "event_id": eid, "ts": ts, "dur": dur or 0.0,
            "core_id": core_id, "pipe_id": pipe_id, "pipe": pipe,
            "direction": _parse_direction(detail, pipe),
            "name_id": nid, "code_id": code_id, "detail_id": did,
            "pc_id": pcid, "addr": addr, "mnemonic": mnemonic,
            "file": inner_file or None, "line": inner_line,
            "outer_file": outer_file or None, "outer_line": outer_line,
            "block_bytes": block, "bytes_source": source,
            "buffer_key": bkey, "duplicate_key": f"{addr}|{dup_key[1]}",
            "repeat_index": repeat_index[rk], "dup_key": dup_key,
            "stride_bytes": stride, "overlap_us": overlap,
        })

    name_map = dict(cur.execute("SELECT id,name FROM names"))
    out = []
    for p in parsed:
        n = dup_count[p["dup_key"]]
        name = name_map.get(p["name_id"], "")
        if "PAD" in name.upper() or "PAD" in (p["buffer_key"] or "").upper():
            cls = "padding_candidate"
        elif n > 1:
            cls = "duplicate_candidate"
        else:
            cls = "unclassified"
        out.append((
            p["event_id"], p["ts"], p["dur"], p["core_id"], p["pipe_id"],
            p["direction"], p["name_id"], p["code_id"], p["detail_id"],
            p["pc_id"], p["addr"], p["file"], p["line"], p["outer_file"],
            p["outer_line"], p["mnemonic"], p["block_bytes"],
            p["bytes_source"], p["buffer_key"], p["duplicate_key"],
            p["repeat_index"], n, cls, p["stride_bytes"], p["overlap_us"]))

    cur.executemany(
        "INSERT INTO dma_events(event_id,ts,dur,core_id,pipe_id,direction,"
        "name_id,code_id,detail_id,pc_id,addr,file,line,outer_file,"
        "outer_line,mnemonic,block_bytes,bytes_source,buffer_key,"
        "duplicate_key,repeat_index,duplicate_count,classification,"
        "stride_bytes,overlap_us)"
        " VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)", out)
    db.commit()
    return len(out)


def analyze_workload(db, ctx, gap_us):
    _insert_pipe_segments(db, _load_pipe_segments(db))
    analyze_wait_attribution(db)
    analyze_pipe_gaps(db, ctx, gap_us)
    analyze_dma(db)


