    queries = """\
-- perfp example queries
-- open with: sqlite3 profile.sqlite

-- 1. Pipe balance (accumulated instruction latency; overlapping pipes)
SELECT name, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM pipes ORDER BY dur_sum_us DESC;

-- 2. Per-core balance
SELECT name, n_events, n_x, ROUND(dur_sum_us,2) AS dur_us
FROM cores ORDER BY dur_sum_us DESC;

-- 3. Top instruction mnemonics by accumulated trace latency
SELECT mnemonic, SUM(calls) AS calls, SUM(cycles) AS cycles,
       SUM(trace_dur_us) AS trace_dur_us
FROM v_instruction GROUP BY mnemonic
ORDER BY trace_dur_us DESC LIMIT 20;

-- 4. Top executed source locations (innermost frame)
SELECT file, line, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM v_exec_location ORDER BY dur_sum_us DESC LIMIT 20;

-- 5. Top kernel call sites (outermost frame)
SELECT file, line, n_events, ROUND(dur_sum_us,2) AS dur_us
FROM v_kernel_location ORDER BY dur_sum_us DESC LIMIT 20;

-- 6. Top instructions, including their source mapping
SELECT addr, mnemonic, pipe, src, calls, cycles, trace_n,
       ROUND(trace_dur_us,2) AS trace_dur_us
FROM v_instruction ORDER BY trace_dur_us DESC LIMIT 20;

-- 7. One core, one time window
SELECT e.ts, e.dur, e.ph,
       (SELECT name FROM names WHERE id = e.name_id) AS name,
       (SELECT code FROM code_stacks WHERE id = e.code_id) AS code
FROM events e
WHERE e.core_id = (SELECT id FROM cores WHERE name='core0.veccore0')
  AND e.ts BETWEEN 10.0 AND 11.0
ORDER BY e.ts;

-- 8. Cross-core synchronization spans
SELECT n.name, COUNT(*) AS count, ROUND(SUM(s.dur),2) AS dur_sum_us,
       ROUND(MAX(s.dur),4) AS dur_max_us
FROM spans s JOIN names n ON n.id = s.name_id
GROUP BY s.name_id ORDER BY SUM(s.dur) DESC;

-- 9. Timeline load per pipe (bucket size is the build --bucket-us)
SELECT h.bucket_start_us, COALESCE(p.name,'') AS pipe,
       h.count, ROUND(h.dur_sum_us,3) AS dur_us
FROM timeline_hist h LEFT JOIN pipes p ON p.id = h.pipe_id
ORDER BY h.bucket_start_us, h.pipe_id;

-- 10. Which source line does the hottest instruction belong to?
SELECT addr, mnemonic, pipe, src, ROUND(trace_dur_us,2) AS trace_dur_us
FROM v_instruction ORDER BY trace_dur_us DESC LIMIT 10;

-- 11. Largest pipe idle gaps and whether a consumer waited on that pipe
SELECT core, pipe, ROUND(ts,4) AS ts, ROUND(dur,4) AS dur_us,
       before_name, after_name, attributed_us, attributed_waits, status, peers
FROM v_pipe_gap ORDER BY dur DESC LIMIT 30;

-- 12. Which consumer source line waited on which producer pipe/source?
SELECT consumer_outer_file, consumer_outer_line, producer_pipe,
       COUNT(*) AS waits, ROUND(SUM(wait_dur),4) AS wait_us,
       ROUND(SUM(COALESCE(delay_us,0)),4) AS delay_us
FROM v_wait_attribution GROUP BY 1,2,3
ORDER BY delay_us DESC LIMIT 30;

-- 13. DMA bytes per kernel source line (instruction-derived estimate)
SELECT file, line, pipe, direction, events, bytes_inferred, overlap_us,
       duplicate_events
FROM v_dma_kernel_source ORDER BY bytes_inferred DESC LIMIT 30;

-- 14. DMA duplicate-read candidates and their estimated excess bytes
SELECT addr, pipe, file, line, events, block_bytes, bytes_inferred,
       ROUND(bytes_inferred - block_bytes,1) AS excess_bytes
FROM v_dma_duplicate ORDER BY bytes_inferred DESC LIMIT 30;

-- 15. DMA buffer shapes / strides (same normalized detail, repeated)
SELECT pipe, direction, addr, file, line, events, bytes_inferred,
       min_block_bytes, max_block_bytes, min_stride_bytes, max_stride_bytes
FROM v_dma_buffer ORDER BY bytes_inferred DESC LIMIT 30;

-- 16. Per core+pipe active time vs idle gaps
SELECT core, pipe, segments, active_us, gap_count, gap_us,
       attributed_gap_us, unattributed_gap_us
FROM v_pipe_activity ORDER BY gap_us DESC LIMIT 30;
"""
    with open(os.path.join(out_dir, "queries.sql"), "w", encoding="utf-8") as f:
        f.write(queries)


