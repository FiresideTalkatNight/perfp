def sparkline(values):
    if not values:
        return ""
    blocks = "▁▂▃▄▅▆▇█"
    mx = max(values) or 1
    return "".join(blocks[min(7, int(v * 7.999 / mx))] for v in values)


def fmt_num(v, digits=2):
    if v is None:
        return "-"
    if isinstance(v, int):
        return f"{v:,}"
    return f"{v:,.{digits}f}"


def build_summary(db, out_dir, ctx, meta):
    cur = db.cursor()
    top_n = meta.get("top_n", 30)

    def rows(sql, params=()):
        return cur.execute(sql, params).fetchall()

    pipes = rows("SELECT name,n_events,dur_sum_us FROM pipes "
                 "ORDER BY dur_sum_us DESC")
    total_pipe_dur = sum(r[2] or 0 for r in pipes) or 1.0
    cores = rows("SELECT name,n_events,n_x,dur_sum_us,ts_min,ts_max FROM cores "
                 "ORDER BY dur_sum_us DESC")
    core_durs = [r[3] or 0 for r in cores]
    top_mnemonics = rows(
        "SELECT mnemonic,SUM(calls),SUM(cycles),SUM(trace_n),SUM(trace_dur_us) "
        "FROM v_instruction GROUP BY mnemonic "
        "ORDER BY SUM(trace_dur_us) DESC LIMIT ?", (top_n,))
    top_exec = rows("SELECT file,line,n_events,dur_sum_us FROM v_exec_location "
                    "ORDER BY dur_sum_us DESC LIMIT ?", (top_n,))
    top_kernel = rows("SELECT file,line,n_events,dur_sum_us FROM v_kernel_location "
                      "ORDER BY dur_sum_us DESC LIMIT ?", (top_n,))
    top_instr = rows(
        "SELECT addr,mnemonic,pipe,src,calls,cycles,trace_n,trace_dur_us "
        "FROM v_instruction ORDER BY trace_dur_us DESC LIMIT ?", (top_n,))
    top_lines = rows(
        "SELECT file,line,loc,calls,cycles FROM v_code_line "
        "ORDER BY cycles DESC LIMIT ?", (top_n,))
    hist = rows("SELECT bucket_start_us,SUM(count),SUM(dur_sum_us) "
                "FROM timeline_hist GROUP BY bucket_start_us "
                "ORDER BY bucket_start_us")
    busy = rows("SELECT bucket_start_us,SUM(count),SUM(dur_sum_us) "
                "FROM timeline_hist GROUP BY bucket_start_us "
                "ORDER BY SUM(count) DESC LIMIT 10")
    span_stats = rows(
        "SELECT n.name,COUNT(*),SUM(s.dur),MAX(s.dur) "
        "FROM spans s JOIN names n ON n.id=s.name_id "
        "GROUP BY s.name_id ORDER BY SUM(s.dur) DESC LIMIT 20")
    top_spans = rows(
        "SELECT n.name,c.name,s.ts,s.dur,s.group_id "
        "FROM spans s JOIN names n ON n.id=s.name_id "
        "JOIN cores c ON c.id=s.core_id ORDER BY s.dur DESC LIMIT 20")
    ph_counts = ctx.ph_counts
    n_cores = len(cores)
    n_events = ctx.event_count
    ts_min = ctx.ts_min
    ts_max = ctx.ts_max
    wall = (ts_max - ts_min) if (ts_min is not None and ts_max is not None) else None

    total_calls = q1(cur, "SELECT SUM(calls) FROM instruction_core") or 0
    total_cycles = q1(cur, "SELECT SUM(cycles) FROM instruction_core") or 0
    per_core_cycles = q1(cur, "SELECT MAX(c) FROM (SELECT SUM(cycles) c "
                              "FROM instruction_core GROUP BY core_id)") or 0
    x_events = sum(v for k, v in ph_counts.items() if k == "X")
    span_count = len(ctx.spans)
    accounted = x_events + span_count

    warnings = list(ctx.warnings)
    if wall and per_core_cycles and per_core_cycles / wall > 5000:
        warnings.append(
            f"`cycles` looks like simulator-internal accounting, not core "
            f"clock cycles: max per-core cycles={per_core_cycles:,} over "
            f"{wall:.1f}us implies {per_core_cycles / wall:,.0f} cycles/us. "
            f"Do not convert it to time; use events.dur for latency.")
    if wall and core_durs and (sum(core_durs) / max(n_cores, 1)) > wall * 1.2:
        warnings.append(
            "Accumulated per-core dur exceeds wall time: instruction "
            "latencies overlap across pipes, so SUM(dur) is not elapsed time.")
    if total_calls and accounted != total_calls:
        warnings.append(
            f"accounted executions (X events {x_events:,} + B/E spans "
            f"{span_count:,} = {accounted:,}) != summed instruction "
            f"executions ({int(total_calls):,}); a few events are unmatched.")
    if n_cores and min(core_durs) > 0:
        spread = max(core_durs) / min(core_durs)
        if spread > 1.05:
            warnings.append(f"core imbalance detected: max/min per-core dur "
                            f"= {spread:.3f}")

    summary = {
        "perfp_version": VERSION,
        "schema_version": SCHEMA_VERSION,
        "input": meta.get("input"),
        "bin_size": meta.get("bin_size"),
        "records": meta.get("records"),
        "case": meta.get("case"),
        "trace": {
            "events": n_events,
            "ph": dict(ph_counts),
            "cores": n_cores,
            "ts_min": ts_min,
            "ts_max": ts_max,
            "wall_us": wall,
            "code_stacks": len(ctx.stacks.items),
            "locations": len(ctx.locations.items),
            "details": len(ctx.details.items),
            "pcs": len(ctx.pcs.items),
            "x_events": x_events,
            "sync_spans": span_count,
            "accounted_executions": accounted,
        },
        "pipes": [
            {"name": r[0], "n_events": r[1], "dur_sum_us": r[2],
             "share": (r[2] or 0) / total_pipe_dur}
            for r in pipes
        ],
        "cores": {
            "count": n_cores,
            "dur_sum_us": {
                "min": min(core_durs) if core_durs else None,
                "max": max(core_durs) if core_durs else None,
                "mean": (sum(core_durs) / n_cores) if n_cores else None,
            },
            "table": [
                {"name": r[0], "n_events": r[1], "n_x": r[2],
                 "dur_sum_us": r[3]} for r in cores
            ],
        },
        "top_mnemonics": [
            {"mnemonic": r[0], "calls": r[1], "cycles": r[2],
             "trace_n": r[3], "trace_dur_us": r[4]} for r in top_mnemonics
        ],
        "top_exec_locations": [
            {"file": r[0], "line": r[1], "n_events": r[2],
             "dur_sum_us": r[3]} for r in top_exec
        ],
        "top_kernel_locations": [
            {"file": r[0], "line": r[1], "n_events": r[2],
             "dur_sum_us": r[3]} for r in top_kernel
        ],
        "top_instructions": [
            {"addr": r[0], "mnemonic": r[1], "pipe": r[2], "src": r[3],
             "calls": r[4], "cycles": r[5], "trace_n": r[6],
             "trace_dur_us": r[7]} for r in top_instr
        ],
        "top_code_lines": [
            {"file": r[0], "line": r[1], "loc": r[2], "calls": r[3],
             "cycles": r[4]} for r in top_lines
        ],
        "total_instruction_executions": int(total_calls),
        "total_cycles": int(total_cycles),
        "sync_spans": {
            "count": sum(r[1] for r in span_stats),
            "by_name": [
                {"name": r[0], "count": r[1], "dur_sum": r[2],
                 "dur_max": r[3]} for r in span_stats
            ],
        },
        "warnings": warnings,
    }

    with open(os.path.join(out_dir, "summary.json"), "w", encoding="utf-8") as f:
        json.dump(summary, f, indent=2, ensure_ascii=False)

    # ---------------- markdown ----------------
    L = []
    add = L.append
    title = (meta.get("case") or {}).get("id") or os.path.basename(
        meta.get("input") or "trace")
    add(f"# perfp summary — {title}\n")
    add(f"Generated by perfp {VERSION} at {meta.get('built_at')}.\n")

    add("## Headline\n")
    if wall is not None:
        add(f"- **{n_cores} cores**, {n_events:,} events, wall **{wall:.2f} us** "
            f"({ts_min:.3f} .. {ts_max:.3f} us).")
    if pipes:
        pn, pn_events, pd = pipes[0]
        add(f"- dominant pipe: **{pn or '(none)'}** -- "
            f"{100 * (pd or 0) / total_pipe_dur:.1f}% of accumulated "
            f"instruction latency.")
    if top_mnemonics:
        mn, mc, _mcy, _mtr, md = top_mnemonics[0]
        add(f"- top mnemonic: **{mn or '(none)'}** -- {fmt_num(md)} us "
            f"accumulated, {fmt_num(mc, 0)} calls.")
    if top_kernel:
        kf, kl, _kn, kd = top_kernel[0]
        add(f"- top kernel site: `{kf}:{kl}` -- {fmt_num(kd)} us accumulated.")
    add("")
    add("_All `dur` figures are accumulated instruction latency; pipes overlap, "
        "so they are relative hotspots, not wall time._")
    add("")

    add("## Input\n")
    add(f"- bin: `{meta.get('input')}` ({human(meta.get('bin_size') or 0)})")
    add(f"- records: {meta.get('records')}")
    if meta.get("case"):
        c = meta["case"]
        add("- case config: " + ", ".join(f"`{k}={v}`" for k, v in c.items()
                                          if k != "id"))
    add("")

    add("## Trace shape\n")
    add(f"- events: **{n_events:,}**")
    add("- by phase: " + ", ".join(f"`{k or '?'}` {v:,}"
                                  for k, v in ph_counts.most_common()))
    add(f"- cores: **{n_cores}**, distinct pipes: {len(pipes)}")
    if wall is not None:
        add(f"- time range: {ts_min:.4f} .. {ts_max:.4f} us "
            f"(wall {wall:.2f} us)")
    add(f"- distinct instruction PCs: {len(ctx.pcs.items):,}")
    add(f"- distinct source stacks: {len(ctx.stacks.items):,}, "
        f"instruction source locations: {len(ctx.locations.items):,}")
    add(f"- instruction executions (summed over cores): "
        f"**{int(total_calls):,}**")
    add(f"- accounted as X events {x_events:,} + B/E sync spans {span_count:,} "
        f"= {accounted:,}")
    add("")

    add("## Pipes (accumulated instruction latency)\n")
    add("| pipe | events | dur_sum_us | share |")
    add("|---|---:|---:|---:|")
    for name, n, dur in pipes:
        add(f"| {name or '(none)'} | {n:,} | {fmt_num(dur)} | "
            f"{100 * (dur or 0) / total_pipe_dur:.1f}% |")
    add("")

    add("## Cores\n")
    add("| core | events | X events | dur_sum_us |")
    add("|---|---:|---:|---:|")
    for name, n, nx, dur, _a, _b in cores[:top_n]:
        add(f"| {name} | {n:,} | {nx:,} | {fmt_num(dur)} |")
    if len(cores) > top_n:
        add(f"| ... ({len(cores) - top_n} more) | | | |")
    add("")

    add("## Top mnemonics (by accumulated trace latency)\n")
    add("| mnemonic | calls | cycles | trace_n | trace_dur_us |")
    add("|---|---:|---:|---:|---:|")
    for m, calls, cyc, tn, td in top_mnemonics:
        add(f"| {m or '(none)'} | {fmt_num(calls, 0)} | {fmt_num(cyc, 0)} | "
            f"{fmt_num(tn, 0)} | {fmt_num(td)} |")
    add("")

    add("## Top executed source locations (innermost frame)\n")
    add("| file | line | events | dur_sum_us |")
    add("|---|---:|---:|---:|")
    for f, line, n, dur in top_exec:
        add(f"| {f} | {line if line is not None else '-'} | {n:,} | "
            f"{fmt_num(dur)} |")
    add("")

    add("## Top kernel call sites (outermost frame)\n")
    add("| file | line | events | dur_sum_us |")
    add("|---|---:|---:|---:|")
    for f, line, n, dur in top_kernel:
        add(f"| {f} | {line if line is not None else '-'} | {n:,} | "
            f"{fmt_num(dur)} |")
    add("")

    add("## Top instructions\n")
    add("| addr | mnemonic | pipe | src | calls | cycles | trace_dur_us |")
    add("|---|---|---|---|---:|---:|---:|")
    for addr, mn, pipe, src, calls, cyc, tn, td in top_instr:
        add(f"| {addr} | {mn} | {pipe} | {src} | {fmt_num(calls, 0)} | "
            f"{fmt_num(cyc, 0)} | {fmt_num(td)} |")
    add("")

    add("## Top source lines (instruction accounting)\n")
    add("| file | line | calls | cycles |")
    add("|---|---:|---:|---:|")
    for f, line, loc, calls, cyc in top_lines:
        add(f"| {f} | {line if line is not None else '-'} | "
            f"{fmt_num(calls, 0)} | {fmt_num(cyc, 0)} |")
    add("")

    add("## Timeline histogram\n")
    if hist:
        add(f"Bucket size {meta.get('bucket_us')} us. Events per bucket:\n")
        add("```")
        add(sparkline([r[1] for r in hist]))
        add("```\n")
        add("| bucket_start_us | events | dur_sum_us |")
        add("|---:|---:|---:|")
        for b, n, dur in busy:
            add(f"| {b:.3f} | {n:,} | {fmt_num(dur)} |")
    add("")

    add("## Synchronization spans (B/E pairs)\n")
    if span_stats:
        add("| name | count | dur_sum_us | dur_max_us |")
        add("|---|---:|---:|---:|")
        for name, n, ds, dm in span_stats:
            add(f"| {name} | {n:,} | {fmt_num(ds)} | {fmt_num(dm)} |")
        add("")
        add("Longest spans:\n")
        add("| name | core | ts | dur_us | group |")
        add("|---|---|---:|---:|---|")
        for name, core, ts, dur, group in top_spans:
            add(f"| {name} | {core} | {fmt_num(ts, 4)} | {fmt_num(dur, 4)} | "
                f"{group} |")
    else:
        add("_no B/E spans found_")
    add("")

    if warnings:
        add("## Warnings / caveats\n")
        for w in warnings:
            add(f"- {w}")
        add("")

    add("## How to query\n")
    add("```bash")
    add(f"sqlite3 {out_dir}/profile.sqlite")
    add("```")
    add("")
    add("Useful views: `v_instruction`, `v_code_line`, `v_code_line_core`, "
        "`v_exec_location`, `v_kernel_location`.")
    add("See `queries.sql` for ready-made queries and `README.md` for the "
        "schema.")
    add("")

    with open(os.path.join(out_dir, "summary.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(L))

    eprint(f"[perfp] summary: {os.path.getsize(os.path.join(out_dir, 'summary.md'))} bytes")


