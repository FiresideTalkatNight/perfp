def finalize_db(db, ctx, bucket_us):
    cur = db.cursor()

    cur.executemany(
        "INSERT INTO cores(id,name,sort_index,n_events,n_x,dur_sum_us,ts_min,ts_max)"
        " VALUES (?,?,?,?,?,?,?,?)",
        [(i, name, ctx.sort_index.get(i), *ctx.core_stats.get(i, [0, 0, 0.0, None, None]))
         for i, name in enumerate(ctx.cores.items)])

    cur.executemany(
        "INSERT INTO pipes(id,name,n_events,dur_sum_us) VALUES (?,?,?,?)",
        [(i, name, *ctx.pipe_stats.get(i, [0, 0.0]))
         for i, name in enumerate(ctx.pipes.items)])

    cur.executemany(
        "INSERT INTO names(id,name,n_events,n_x,dur_sum_us) VALUES (?,?,?,?,?)",
        [(i, name, *ctx.name_stats.get(i, [0, 0, 0.0]))
         for i, name in enumerate(ctx.names.items)])

    stack_rows = []
    for i, code in enumerate(ctx.stacks.items):
        inner_file, inner_line, outer_file, outer_line = \
            ctx.stack_meta.get(i, (None, None, None, None))
        n, dur = ctx.stack_stats.get(i, [0, 0.0])
        stack_rows.append((i, code, inner_file, inner_line,
                           outer_file, outer_line, n, dur))
    cur.executemany(
        "INSERT INTO code_stacks(id,code,inner_file,inner_line,outer_file,"
        "outer_line,n_events,dur_sum_us) VALUES (?,?,?,?,?,?,?,?)",
        stack_rows)

    loc_rows = []
    for i, text in enumerate(ctx.locations.items):
        file, line = split_loc(text)
        loc_rows.append((i, text, file, line))
    cur.executemany(
        "INSERT INTO locations(id,text,file,line) VALUES (?,?,?,?)", loc_rows)

    cur.executemany(
        "INSERT INTO details(id,detail) VALUES (?,?)",
        [(i, d) for i, d in enumerate(ctx.details.items)])

    cur.executemany(
        "INSERT INTO pcs(id,addr,n_events,dur_sum_us) VALUES (?,?,?,?)",
        [(i, addr, *ctx.pc_stats.get(i, [0, 0.0]))
         for i, addr in enumerate(ctx.pcs.items)])

    cur.executemany(
        "INSERT INTO spans(id,core_id,group_id,name_id,pipe_id,ts,dur)"
        " VALUES (?,?,?,?,?,?,?)",
        [(i, *s) for i, s in enumerate(ctx.spans)])

    cur.executemany(
        "INSERT INTO timeline_hist(bucket_start_us,pipe_id,count,dur_sum_us)"
        " VALUES (?,?,?,?)",
        [(b * bucket_us, pid, n, dur)
         for (b, pid), (n, dur) in sorted(ctx.hist.items())])

    db.commit()


