def find_case_files(bin_path):
    d = os.path.dirname(os.path.abspath(bin_path))
    case_json = None
    sim_log = None
    for _ in range(5):
        if sim_log is None:
            logs = sorted(glob.glob(os.path.join(d, "*.sim.log")) +
                          glob.glob(os.path.join(d, "*sim.log")))
            if logs:
                sim_log = logs[0]
        if case_json is None:
            for jp in sorted(glob.glob(os.path.join(d, "*.json"))):
                try:
                    with open(jp, encoding="utf-8") as f:
                        o = json.load(f)
                except Exception:
                    continue
                if isinstance(o, dict) and "id" in o and (
                        "B" in o or "dtype" in o or "M" in o):
                    case_json = o
                    break
        if case_json is not None and sim_log is not None:
            break
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    return case_json, sim_log


def parse_simlog(path):
    rows = []
    in_table = False
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            s = line.strip()
            if s.startswith("core_name"):
                in_table = True
                continue
            if not in_table:
                continue
            parts = s.split()
            if len(parts) >= 3 and parts[0].startswith("core"):
                try:
                    rows.append((parts[0], float(parts[1]), float(parts[2])))
                except ValueError:
                    pass
            elif rows:
                in_table = False
    return rows


