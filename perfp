def write_csv(path, header, rows):
    with open(path, "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(header)
        w.writerows(rows)


def export_csvs(db, out_dir, ctx, want_events=True, top_n=30,
                events_plain=False):
    cur = db.cursor()
    d = os.path.join(out_dir, "csv")
    os.makedirs(d, exist_ok=True)

    write_csv(os.path.join(d, "cores.csv"),
              ["id", "name", "sort_index", "n_events", "n_x",
               "dur_sum_us", "ts_min", "ts_max"],
              cur.execute("SELECT id,name,sort_index,n_events,n_x,dur_sum_us,"
                          "ts_min,ts_max FROM cores ORDER BY id").fetchall())

    write_csv(os.path.join(d, "pipes.csv"),
              ["id", "name", "n_events", "dur_sum_us"],
              cur.execute("SELECT id,name,n_events,dur_sum_us FROM pipes "
                          "ORDER BY dur_sum_us DESC").fetchall())

    write_csv(os.path.join(d, "names.csv"),
              ["id", "name", "n_events", "n_x", "dur_sum_us"],
              cur.execute("SELECT id,name,n_events,n_x,dur_sum_us FROM names "
                          "ORDER BY dur_sum_us DESC").fetchall())

    write_csv(os.path.join(d, "code_stacks.csv"),
              ["id", "n_events", "dur_sum_us", "inner_file", "inner_line",
               "outer_file", "outer_line", "code"],
              cur.execute("SELECT id,n_events,dur_sum_us,inner_file,inner_line,"
                          "outer_file,outer_line,code FROM code_stacks "
                          "ORDER BY dur_sum_us DESC").fetchall())

    write_csv(os.path.join(d, "exec_locations.csv"),
              ["file", "line", "n_events", "dur_sum_us", "stacks"],
              cur.execute("SELECT file,line,n_events,dur_sum_us,stacks "
                          "FROM v_exec_location ORDER BY dur_sum_us DESC").fetchall())

    write_csv(os.path.join(d, "kernel_locations.csv"),
              ["file", "line", "n_events", "dur_sum_us", "stacks"],
              cur.execute("SELECT file,line,n_events,dur_sum_us,stacks "
                          "FROM v_kernel_location ORDER BY dur_sum_us DESC").fetchall())

    write_csv(os.path.join(d, "instructions.csv"),
              ["addr", "mnemonic", "pipe", "src", "file", "line",
               "calls", "cycles", "core_count", "trace_n", "trace_dur_us"],
              cur.execute("SELECT addr,mnemonic,pipe,src,file,line,calls,cycles,"
                          "core_count,trace_n,trace_dur_us FROM v_instruction "
                          "ORDER BY trace_dur_us DESC").fetchall())

    write_csv(os.path.join(d, "code_lines.csv"),
              ["file", "line", "loc", "calls", "cycles", "core_count"],
              cur.execute("SELECT file,line,loc,calls,cycles,core_count "
                          "FROM v_code_line ORDER BY cycles DESC").fetchall())

    write_csv(os.path.join(d, "files.csv"),
              ["id", "path", "local_path", "size", "n_lines"],
              cur.execute("SELECT id,path,local_path,size,n_lines FROM files "
                          "ORDER BY id").fetchall())

    write_csv(os.path.join(d, "file_lines.csv"),
              ["file_id", "line", "addr_ranges", "cycles", "gpr",
               "instructions_executed", "process_bytes"],
              cur.execute("SELECT file_id,line,addr_ranges,cycles,gpr,"
                          "instructions_executed,process_bytes FROM file_lines "
                          "ORDER BY file_id,line").fetchall())

    write_csv(os.path.join(d, "timeline_hist.csv"),
              ["bucket_start_us", "pipe", "count", "dur_sum_us"],
              cur.execute("SELECT h.bucket_start_us, COALESCE(p.name,''), "
                          "h.count, h.dur_sum_us FROM timeline_hist h "
                          "LEFT JOIN pipes p ON p.id=h.pipe_id "
                          "ORDER BY h.bucket_start_us, h.pipe_id").fetchall())

    write_csv(os.path.join(d, "spans.csv"),
              ["id", "core", "group_id", "name", "pipe", "ts", "dur"],
              cur.execute("SELECT s.id, COALESCE(c.name,''), s.group_id, "
                          "COALESCE(n.name,''), COALESCE(p.name,''), "
                          "s.ts, s.dur FROM spans s "
                          "LEFT JOIN cores c ON c.id=s.core_id "
                          "LEFT JOIN names n ON n.id=s.name_id "
                          "LEFT JOIN pipes p ON p.id=s.pipe_id "
                          "ORDER BY s.dur DESC").fetchall())

    # instruction_core is large: stream it
    with open(os.path.join(d, "instruction_core.csv"), "w", newline="",
              encoding="utf-8") as f:
        w = csv.writer(f)
        w.writerow(["addr", "core", "calls", "cycles", "gpr",
                    "process_bytes", "ub_read_conflict", "ub_write_conflict",
                    "vector_util"])
        for row in cur.execute(
                "SELECT ic.addr, COALESCE(c.name,''), ic.calls, ic.cycles, "
                "ic.gpr, ic.process_bytes, ic.ub_read_conflict, "
                "ic.ub_write_conflict, ic.vector_util "
                "FROM instruction_core ic "
                "LEFT JOIN cores c ON c.id=ic.core_id "
                "ORDER BY ic.addr, ic.core_id"):
            w.writerow(row)

    # top events
    rows = []
    for dur, eid, ts, ph, nid, cid, pid, pcid, sid in sorted(
            ctx.top_events, reverse=True):
        rows.append((eid, ts, dur, ph,
                     ctx.cores.items[cid],
                     ctx.pipes.items[pid],
                     ctx.names.items[nid],
                     ctx.pcs.items[pcid] if pcid is not None else "",
                     ctx.stacks.items[sid][:200] if sid is not None else ""))
    write_csv(os.path.join(d, "top_events.csv"),
              ["event_id", "ts", "dur", "ph", "core", "pipe", "name",
               "pc", "code"], rows)

    # full event stream, dictionary encoded
    if want_events:
        core_map = dict(cur.execute("SELECT id,name FROM cores"))
        pipe_map = dict(cur.execute("SELECT id,name FROM pipes"))
        name_map = dict(cur.execute("SELECT id,name FROM names"))
        pc_map = dict(cur.execute("SELECT id,addr FROM pcs"))
        name = "events.csv" if events_plain else "events.csv.gz"
        dest = os.path.join(d, name)
        opener = (open(dest, "w", newline="", encoding="utf-8") if events_plain
                  else gzip.open(dest, "wt", newline="", encoding="utf-8",
                                 compresslevel=6))
        with opener as f:
            w = csv.writer(f)
            w.writerow(["id", "ts", "dur", "ph", "core", "pipe", "name",
                        "code_id", "pc", "detail_id"])
            for row in cur.execute(
                    "SELECT id,ts,dur,ph,core_id,pipe_id,name_id,code_id,"
                    "pc_id,detail_id FROM events ORDER BY id"):
                eid, ts, dur, ph, cid, pid, nid, sid, pcid, did = row
                w.writerow([eid, ts, dur, ph,
                            core_map.get(cid, ""),
                            pipe_map.get(pid, ""),
                            name_map.get(nid, ""),
                            "" if sid is None else sid,
                            pc_map.get(pcid, ""),
                            "" if did is None else did])
        eprint(f"[perfp] events csv: {human(os.path.getsize(dest))}")


